\input docstrip.tex
\keepsilent
\generateFile{pdfjsarticle.cls}{f}{\from{pdfjsclasses.dtx}{article}}
\generateFile{pdfjsbook.cls}{f}{\from{pdfjsclasses.dtx}{book}}
\generateFile{pdfjsreport.cls}{f}{\from{pdfjsclasses.dtx}{report}}
\generateFile{pdfjspf.cls}{f}{\from{pdfjsclasses.dtx}{jspf}}
\generateFile{pdfjskiyou.cls}{f}{\from{pdfjsclasses.dtx}{kiyou}}

\endbatchfile

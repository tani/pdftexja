\generateFile{pdfjsize11.clo}{f}{\from{pdfjclasses.dtx}{11pt,yoko}}
\generateFile{pdfjsize12.clo}{f}{\from{pdfjclasses.dtx}{12pt,yoko}}
\generateFile{pdfjbk10.clo}{f}{\from{pdfjclasses.dtx}{10pt,bk,yoko}}
\generateFile{pdfjbk11.clo}{f}{\from{pdfjclasses.dtx}{11pt,bk,yoko}}
\generateFile{pdfjbk12.clo}{f}{\from{pdfjclasses.dtx}{12pt,bk,yoko}}

\generateFile{pdfjtarticle.cls}{f}{\from{pdfjclasses.dtx}{article,tate}}
\generateFile{pdfjtreport.cls}{f}{\from{pdfjclasses.dtx}{report,tate}}
\generateFile{pdfjtbook.cls}{f}{\from{pdfjclasses.dtx}{book,tate}}
\generateFile{pdfjtsize10.clo}{f}{\from{pdfjclasses.dtx}{10pt,tate}}
\generateFile{pdfjtsize11.clo}{f}{\from{pdfjclasses.dtx}{11pt,tate}}
\generateFile{pdfjtsize12.clo}{f}{\from{pdfjclasses.dtx}{12pt,tate}}
\generateFile{pdfjtbk10.clo}{f}{\from{pdfjclasses.dtx}{10pt,bk,tate}}
\generateFile{pdfjtbk11.clo}{f}{\from{pdfjclasses.dtx}{11pt,bk,tate}}
\generateFile{pdfjtbk12.clo}{f}{\from{pdfjclasses.dtx}{12pt,bk,tate}}

\endbatchfile

%. ------------------------------------------- kanji numerals (\kansuji)
% pTeXの\kansujiに相当するプリミティブはpdfTeXには無い．uplatex/platexでの
% 実測（0–1000000をtypeout照合）により，pTeXの仕様は「十進の各桁を
% 〇一二三四五六七八九に置き換える」桁置換であり（10→一〇，100→一〇〇，
% 2025→二〇二五），十・百・千の位取りは行わない．0→〇，負数→空．
% これを完全展開可能なマクロで再現する．
%
% always-on CJK下では和文リテラル（UTF-8活字化バイト列）を\edefや素の
% \writeで展開するとCJK内部の条件分岐（\CJK@XXX）が破綻するため，字形
% への置換は組版時まで遅延させる設計:
%  * \pdftexja@kjczero..\pdftexja@kjcnine : 各桁の生文字マクロ（UTF-8リテラル）．
%  * \pdftexja@kansuji@digit{<d>} : 1桁印字．\protectedなので\edef/\write/
%    \mark/\typeoutのすべてで凍結され，TOC・柱・見出しラベルを安全に
%    通過する（組版時に展開されて生文字を出力）．
%  * \pdftexja@kansuji{<num>} : 完全展開可能．<num>は\numexpr式または
%    単一トークン（\c@chapter等）．展開結果は\pdftexja@kansuji@digitの列．
%    jlreq.clsの\pdftexja@Kanji（d側）からカウンタ名経由で呼ばれる．
%  * \pdftexja@kansuji@run{<printer>}{<num>} : プリンタ差替口．テストが
%    \detokenize系プリンタを渡してログ照合に用いる．
\def\pdftexja@kjczero{〇}
\def\pdftexja@kjcone{一}
\def\pdftexja@kjctwo{二}
\def\pdftexja@kjcthree{三}
\def\pdftexja@kjcfour{四}
\def\pdftexja@kjcfive{五}
\def\pdftexja@kjcsix{六}
\def\pdftexja@kjcseven{七}
\def\pdftexja@kjceight{八}
\def\pdftexja@kjcnine{九}
\protected\def\pdftexja@kansuji@digit#1{%
  \ifcase#1 \pdftexja@kjczero\or \pdftexja@kjcone\or \pdftexja@kjctwo\or \pdftexja@kjcthree\or
    \pdftexja@kjcfour\or \pdftexja@kjcfive\or \pdftexja@kjcsix\or \pdftexja@kjcseven\or
    \pdftexja@kjceight\or \pdftexja@kjcnine\fi}
\def\pdftexja@kansuji#1{\pdftexja@kansuji@run\pdftexja@kansuji@digit{#1}}
\def\pdftexja@kansuji@run#1#2{%
  \expandafter\pdftexja@kansuji@norm\expandafter#1\expandafter{\the\numexpr#2\relax}}
% #1=プリンタ，#2=符号付き10進文字列（\the\numexpr済み）．負数は空．
\def\pdftexja@kansuji@norm#1#2{%
  \ifnum#2<\z@\else\pdftexja@kansuji@loop#1#2\pdftexja@kansuji@stop\fi}
% 再帰呼出しは \expandafter で自身の \fi を先に閉じる（さもないと次桁ではなく
% \fi が #2 として拾われて無限再帰になる，定番の罠）．
\def\pdftexja@kansuji@loop#1#2{%
  \ifx#2\pdftexja@kansuji@stop
  \else
    #1{#2}%
    \expandafter\pdftexja@kansuji@loop\expandafter#1%
  \fi}
\def\pdftexja@kansuji@stop{\pdftexja@kansuji@stop}

% public entry: \kansuji{<number>} (pTeX-compatible digit substitution)
\def\kansuji#1{\pdftexja@kansuji{#1}}


%. ------------------------------------------------- unit normalization
% \pdftexjaNormalizeUnits{<expl3 tl variable>}: replace a literal zw/zh
% immediately after a digit with the unit macro, and Q/H with
% 0.25mm. Digits not followed by a unit and unit letters that are part
% of a macro name are untouched. The caller's tl is updated in place.
\def\pdftexjaNormalizeUnits#1{%
  \pdftexja@normalize@tl{#1}%
}
\def\pdftexja@normalize@tl#1{%
  \tl_set:Nx #1 {#1}%
  \pdftexja@normalize@units{#1}%
}
\def\pdftexja@normalize@units#1{%
  \tl_map_inline:nn {0123456789} {%
    \tl_replace_all:Nnn #1 {##1 zw} {##1\zw}%
    \tl_replace_all:Nnn #1 {##1 zh} {##1\zh}%
    \tl_replace_all:Nnn #1 {##1 Q} {##1\dimexpr 0.25mm\relax}%
    \tl_replace_all:Nnn #1 {##1 H} {##1\dimexpr 0.25mm\relax}%
  }%
}

%. --------------------------------------------- UTF-8 command spellings
% A Japanese control sequence `\<first byte><rest bytes>' is a control
% symbol named by the FIRST byte only (8-bit engines cannot name a CS
% with several bytes). The dispatcher consumes exactly the registered
% byte run and replaces it with a stable protected ASCII command.
%
% Storage:
%   \pdftexja@utf@cands@<n>          candidates for leading byte <n>, where
%                                    <n> is the DECIMAL byte value
%   \pdftexja@utf@c{<rest>}{<target>} one candidate; <rest> is the byte run
%                                    after the leading byte
%   \<byte>                          the control symbol, defined once to
%                                    \pdftexja@utf@go{<n>}
%
% The candidate list is EXECUTED, never picked apart structurally:
% \pdftexja@utf@c routes through \pdftexja@utf@op, which every pass points
% at the operation it wants (probe or filter).  A structural reader
% re-frames the per-candidate groups on each pass and drops an exhausted
% candidate; executing the list cannot.
%
% Consumed bytes are compared by character CODE (\ifnum`#1=...), so a
% stored byte and the byte read from the input match whatever their catcodes
% are.  The lookahead cannot consume, so there the comparison is \ifx on
% the unread token and the stored head byte - two single-character tokens
% taken from the same catcode table.
%
% One spelling may be a strict prefix of another with the same leading
% byte (e.g. `\西暦' and `\西暦true'): the LONGEST match wins.  When a
% complete candidate coexists with longer ones, \futurelet looks at the
% next token without consuming it - descending if it continues a longer
% spelling, and otherwise firing the complete one and leaving that token
% in the stream untouched.
\def\pdftexja@utf@c#1#2{\pdftexja@utf@op{#1}{#2}}
\def\pdftexja@utf@op#1#2{}
\def\pdftexja@utf@list{}
\def\pdftexja@utf@newlist{}
\def\pdftexja@utf@candlist{}
\newif\ifpdftexja@utf@hit
\newif\ifpdftexja@utf@open
\newif\ifpdftexja@utf@extend
\newif\ifpdftexja@utf@char

% public registration (preamble only)
\def\pdftexjaDeclareUTFCommand#1#2{%
  \pdftexja@preambleonly{\pdftexjaDeclareUTFCommand}%
  \def\pdftexja@utf@spell{#1}%
  \ifx\pdftexja@utf@spell\@empty
    \PackageError{pdftexja}{empty UTF command spelling}{%
      A~command~spelling~must~contain~at~least~one~UTF-8~byte.\MessageBreak
      \@ehc}%
  \else
    \pdftexja@utf@split#1\pdftexja@utf@end{#2}%
  \fi}
% #1 = first byte, #2 = remaining spelling tokens, #3 = target
\def\pdftexja@utf@split#1#2\pdftexja@utf@end#3{%
  \def\pdftexja@utf@rest{#2}%
  \ifx\pdftexja@utf@rest\@empty
    \PackageError{pdftexja}{UTF command spelling must be multi-byte}{%
      The~registered~spelling~has~a~single~byte;~a~one-byte~control\MessageBreak
      symbol~cannot~be~dispatched~safely~on~this~engine.\MessageBreak
      \@ehc}%
  \else
    \ifcat\noexpand#3\relax
      \pdftexja@utf@register{#1}{#2}{#3}%
    \else
      \PackageError{pdftexja}{UTF command target must be a single control sequence}{%
        The~second~argument~of~\string\pdftexjaDeclareUTFCommand\space\MessageBreak
        must~be~one~control~sequence.\MessageBreak
        \@ehc}%
    \fi
  \fi}
\def\pdftexja@utf@register#1#2#3{%
  \edef\pdftexja@utf@byte{\string#1}%
  \edef\pdftexja@utf@val{\number`#1}%
  \edef\pdftexja@utf@key{\detokenize{#1#2}}%
  \expandafter\ifx\csname pdftexja@utf@declared@\pdftexja@utf@key\endcsname\relax
    \expandafter\def\csname pdftexja@utf@declared@\pdftexja@utf@key\endcsname{1}%
    % the control symbol for this leading byte is defined once; later
    % registrations only append to the candidate list
    \expandafter\ifx\csname pdftexja@utf@cands@\pdftexja@utf@val\endcsname\relax
      \expandafter\def\csname pdftexja@utf@cands@\pdftexja@utf@val\endcsname{}%
      \edef\pdftexja@utf@entry{\noexpand\pdftexja@utf@go{\pdftexja@utf@val}}%
      \expandafter\let\csname\pdftexja@utf@byte\endcsname\pdftexja@utf@entry
    \fi
    \expandafter\let\expandafter\pdftexja@utf@candlist
      \csname pdftexja@utf@cands@\pdftexja@utf@val\endcsname
    \pdftexja@utf@addcand{#2}{#3}%
    \expandafter\let\csname pdftexja@utf@cands@\pdftexja@utf@val\endcsname
      \pdftexja@utf@candlist
  \else
    \PackageError{pdftexja}{duplicate UTF command spelling}{%
      The~spelling~is~already~registered.\MessageBreak \@ehc}%
  \fi}
% append a candidate to \pdftexja@utf@candlist.  The stored spelling is
% kept as the byte tokens themselves; the filter compares their character
% codes, so a stored byte and an input byte agree whatever their catcodes
% are.
\def\pdftexja@utf@addcand#1#2{%
  \toks@\expandafter{\pdftexja@utf@candlist}%
  \toks@\expandafter{\the\toks@\pdftexja@utf@c{#1}{#2}}%
  \expandafter\def\expandafter\pdftexja@utf@candlist\expandafter{\the\toks@}}
% append a surviving candidate to \pdftexja@utf@newlist
\def\pdftexja@utf@addraw#1#2{%
  \toks@\expandafter{\pdftexja@utf@newlist}%
  \toks@\expandafter{\the\toks@\pdftexja@utf@c{#1}{#2}}%
  \expandafter\def\expandafter\pdftexja@utf@newlist\expandafter{\the\toks@}}
% dispatch entry (installed as the control symbol body)
\def\pdftexja@utf@go#1{%
  \expandafter\pdftexja@utf@load\csname pdftexja@utf@cands@#1\endcsname}
\def\pdftexja@utf@load#1{%
  \def\pdftexja@utf@list{#1}%
  \pdftexja@utf@probe}
% probe: is some candidate complete, and is some other candidate still
% open?  Nothing is read from the input here.
\def\pdftexja@utf@probe{%
  \pdftexja@utf@hitfalse
  \pdftexja@utf@openfalse
  \let\pdftexja@utf@op\pdftexja@utf@probe@one
  \pdftexja@utf@list
  \pdftexja@utf@probe@done}
\def\pdftexja@utf@probe@one#1#2{%
  \def\pdftexja@utf@rest{#1}%
  \ifx\pdftexja@utf@rest\@empty
    \pdftexja@utf@hittrue
    \def\pdftexja@utf@target{#2}%
  \else
    \pdftexja@utf@opentrue
  \fi}
\def\pdftexja@utf@probe@done{%
  \let\pdftexja@utf@next\relax
  \ifpdftexja@utf@hit
    \ifpdftexja@utf@open
      \let\pdftexja@utf@next\pdftexja@utf@peek
    \else
      \let\pdftexja@utf@next\pdftexja@utf@target
    \fi
  \else
    \let\pdftexja@utf@next\pdftexja@utf@readnext
  \fi
  \pdftexja@utf@next}
% A complete spelling coexists with longer spellings sharing the leading
% byte: longest match wins, so look at the next input token WITHOUT
% consuming it.  \futurelet is the only thing that touches it here; if it
% does not continue a longer spelling the complete one fires and the token
% is left in the stream to be processed normally.
\def\pdftexja@utf@peek{%
  \futurelet\pdftexja@utf@peektok\pdftexja@utf@peek@check}
\def\pdftexja@utf@peek@check{%
  \pdftexja@utf@extendfalse
  \let\pdftexja@utf@op\pdftexja@utf@extend@one
  \pdftexja@utf@list
  \ifpdftexja@utf@extend
    \let\pdftexja@utf@next\pdftexja@utf@readnext
  \else
    \let\pdftexja@utf@next\pdftexja@utf@target
  \fi
  \pdftexja@utf@next}
% read-only pass over the candidates: does one of them continue with the
% peeked token?  The peeked token and the stored head byte are both
% single-character tokens read under the same catcode table, so \ifx is
% the catcode-preserving comparison here (nothing is expanded).
\def\pdftexja@utf@extend@one#1#2{%
  \def\pdftexja@utf@rest{#1}%
  \ifx\pdftexja@utf@rest\@empty
  \else
    \pdftexja@utf@extend@head#1\pdftexja@utf@stop
  \fi}
\def\pdftexja@utf@extend@head#1#2\pdftexja@utf@stop{%
  \def\pdftexja@utf@headtok{#1}%
  \expandafter\let\expandafter\pdftexja@utf@headtok\pdftexja@utf@headtok
  \ifx\pdftexja@utf@peektok\pdftexja@utf@headtok
    \pdftexja@utf@extendtrue
  \fi}
% read the next input byte (unexpanded: the active character token stays
% a character token) and remember its code
\def\pdftexja@utf@readnext#1{%
  \pdftexja@utf@charcode{#1}%
  \ifpdftexja@utf@char
    \let\pdftexja@utf@next\pdftexja@utf@filter
  \else
    \let\pdftexja@utf@next\pdftexja@utf@unknown
  \fi
  \pdftexja@utf@next}
% \pdftexja@utf@num <- code of the byte, unless the token is not a
% character at all (a control sequence cannot be part of a byte run).
% The conditional must be closed here: nothing below this macro may read
% from the document stream while a conditional of ours is still open, or
% the next input grab would swallow the pending \fi.
\def\pdftexja@utf@charcode#1{%
  \ifcat\noexpand#1\relax
    \pdftexja@utf@charfalse
  \else
    \pdftexja@utf@chartrue
    \edef\pdftexja@utf@num{\number`#1}%
  \fi}
% keep the candidates whose next byte matches the input byte, stripped of
% that byte; the rest are dropped
\def\pdftexja@utf@filter{%
  \def\pdftexja@utf@newlist{}%
  \let\pdftexja@utf@op\pdftexja@utf@filter@one
  \pdftexja@utf@list
  \pdftexja@utf@filter@done}
% A candidate whose spelling is already exhausted is DROPPED here: the
% filter runs only after the input was seen to continue (either no candidate
% was complete, or the lookahead matched a longer one), so the shorter
% spelling can no longer be the answer.
\def\pdftexja@utf@filter@one#1#2{%
  \def\pdftexja@utf@rest{#1}%
  \ifx\pdftexja@utf@rest\@empty
  \else
    \pdftexja@utf@strip#1\pdftexja@utf@stop{#2}%
  \fi}
\def\pdftexja@utf@strip#1#2\pdftexja@utf@stop#3{%
  \ifnum`#1=\pdftexja@utf@num\relax
    \pdftexja@utf@addraw{#2}{#3}%
  \fi}
\def\pdftexja@utf@filter@done{%
  \let\pdftexja@utf@list\pdftexja@utf@newlist
  \ifx\pdftexja@utf@list\@empty
    \let\pdftexja@utf@next\pdftexja@utf@unknown
  \else
    \let\pdftexja@utf@next\pdftexja@utf@probe
  \fi
  \pdftexja@utf@next}
\def\pdftexja@utf@unknown{%
  \PackageError{pdftexja}{unknown command spelling}{%
    The~byte~run~after~the~control~symbol~is~not~a~registered~UTF\MessageBreak
    command~spelling.~Register~it~with~\string\pdftexjaDeclareUTFCommand.\MessageBreak
    \@ehc}}

% full-width space spelling (U+3000, e3 80 80): an explicit Japanese
% space is one zw of glue with the neutral explicit-space boundary state.
\protected\def\pdftexja@zenkakuspace{%
  \ifvmode\leavevmode\fi
  \hskip 1\zw\relax
  \global\pdftexja@lastclass=93
  \global\pdftexja@lastnodechar=12288 % U+3000
}
\def\pdftexja@zenkakaspace@{\pdftexja@zenkakuspace}
\pdftexjaDeclareUTFCommand{^^e3^^80^^80}{\pdftexja@zenkakaspace@}

%. ------------------------------- label key normalizer
% Symmetric normalization of Japanese label keys.  With always-on CJK
% (active UTF-8 byte macros) a bare key inside \csname r@<key>\endcsname
% leaks the byte macros' \global/\futurelet and raises "Missing
% \endcsname".  The CJK byte macros freeze themselves while \protect is
% \@unexpandable@protect, so: (1) freeze with \protected@edef,
% (2) normalize catcodes with \detokenize (identity for ASCII keys,
% byte-preserving for UTF-8).  The result is returned in
% \pdftexja@labelkey@out.
\long\def\pdftexja@labelkey#1{%
  \begingroup
    \let\protect\@unexpandable@protect
    \protected@edef\pdftexja@labelkey@res{#1}%
    \protected@edef\pdftexja@labelkey@res{\detokenize\expandafter{\pdftexja@labelkey@res}}%
  \expandafter\endgroup
  \expandafter\def\expandafter\pdftexja@labelkey@out\expandafter{\pdftexja@labelkey@res}%
}
\long\def\pdftexja@labelkey@write#1#2{%
  \protected@write#1{}{#2}%
}

%. ------------------------------------------------ Japanese reference keys
% kernel の label/ref 面のうち、key が \csname r@<key>\endcsname に
% 裸で渡る箇所に同一正規化を挿入する:
%   * \label（書込）: \protected@write の前に key を正規化
%   * \newlabel / \@newl@bel（aux 読込）: key を正規化してから
%     \gdef\csname r@<key> に渡す
%   * \ref/\pageref（star 両形; \eqref は \ref 経由）: query key を正規化
% パッケージ面（nameref/hyperref/refcount/cleveref）は begin document 後、
% 各パッケージの実装を上書きする（kernel 面と同じ正規化器を使用）。
% 読込側（aux の \newlabel 行）だけは kernel が aux を読む
% \UseOneTimeHook{begindocument} の「前」に実行されるため、
% \AtBeginDocument では間に合わない（実測: latex.ltx \document は
% \@input{\jobname.aux} を begindocument hook より前に置く）。
% begindocument/before は aux 読込より前に発火する唯一のフック。
\AddToHook{begindocument/before}{%
  % --- (2) \newlabel: aux 読込側（key を正規化してから r@<key> を定義）---
  \def\newlabel#1#2{%
    \pdftexja@labelkey{#1}%
    \expandafter\gdef\csname r@\pdftexja@labelkey@out\endcsname{#2}}%
}
\AtBeginDocument{%
  % --- (1) \label: write 側（kernel 定義を正規化版で上書き）---
  \def\label#1{%
    \@bsphack
    \begingroup
      \UseHookWithArguments{label}{1}{#1}%
      \pdftexja@labelkey{#1}%
      \protected@write\@auxout{}%
         {\string\newlabel{\pdftexja@labelkey@out}{{\@currentlabel}{\thepage}%
          {\@currentlabelname}{\@currentHref}{\@kernel@reserved@label@data}}}%
    \endgroup
    \@esphack}%
  % --- (3) \ref / \pageref: query 側（star 両形; eqref は \ref 経由）---
  \renewcommand{\ref}{\@ifstar{\pdftexja@ref@ref@n@s}{\pdftexja@ref@ref@n@ns}}%
  \renewcommand{\pageref}{\@ifstar{\pdftexja@ref@pageref@n@s}{\pdftexja@ref@pageref@n@ns}}%
  \newcommand{\pdftexja@ref@ref@n@ns}[1]{\pdftexja@ref@setref{#1}\@firstoffive}%
  \newcommand{\pdftexja@ref@ref@n@s}[1]{\pdftexja@ref@setref{#1}\@firstoffive}%
  \newcommand{\pdftexja@ref@pageref@n@ns}[1]{\pdftexja@ref@setref{#1}\@secondoffive}%
  \newcommand{\pdftexja@ref@pageref@n@s}[1]{\pdftexja@ref@setref{#1}\@secondoffive}%
  % \pdftexja@ref@setref{<raw key>}{<selector>}: kernel \@setref と同一の二段構成。
  % 第一段: \csname r@<正規化key> を先に展開して「cs トークン」を作り、
  % 第二段（\pdftexja@ref@setref@i）で \expandafter#2#1 の形でその中身を
  % selector に渡す（kernel \setref の "\expandafter#2#1\@empty.." と同じ）。
  \newcommand{\pdftexja@ref@setref}[2]{%
    \pdftexja@labelkey{#1}%
    \expandafter\pdftexja@ref@setref@i
      \csname r@\pdftexja@labelkey@out\endcsname{#2}{#1}}%
  \newcommand{\pdftexja@ref@setref@i}[3]{%
    \ifx#1\relax
      \protect\G@refundefinedtrue
      \nfss@text{\reset@font\bfseries ??}%
      \@latex@warning{Reference `#3' on page \thepage \space undefined}%
    \else
      \expandafter#2#1\@empty\@empty\@empty\null
    \fi}%
}
  % --- (4) パッケージ面（nameref/hyperref/refcount/cleveref hooks）---
  % begindocument/end は全 begindocument フック（nameref の \ref 再定義、
  % hyperref の諸設定）より後に発火するため、ここで各パッケージの
  % key 渡し面に同じ正規化を接続する。
  \AddToHook{begindocument/end}{%
    % nameref: \NR@setref の \csname r@#1 を正規化 key で組み直す
    \@ifundefined{NR@setref}{}{%
      \def\NR@setref#1{%
        \pdftexja@labelkey{#1}%
        \begingroup
          \@safe@activestrue
          \expandafter
        \endgroup
        \expandafter\NR@@setref
          \csname r@\pdftexja@labelkey@out\endcsname}%
    }%
    % hyperref: \label@hyperref（\hyperref[..] の key 照合）と
    % \HyRef@autoref（\autoref の key 照合）の \csname r@<key> を正規化
    \@ifundefined{label@hyperref}{}{%
      \def\label@hyperref[#1]{%
        \pdftexja@labelkey{#1}%
        \expandafter\label@@hyperref
          \csname r@\pdftexja@labelkey@out\endcsname{#1}}%
    }%
    \@ifundefined{HyRef@autoref}{}{%
      \def\HyRef@autoref#1#2{%
        \pdftexja@labelkey{#2}%
        \begingroup
          \Hy@safe@activestrue
          \expandafter\HyRef@autosetref
            \csname r@\pdftexja@labelkey@out\endcsname{#2}{#1}%
        \endgroup}%
    }%
    % refcount: \rc@set（定義文脈）は正規化を先行させる。
    % \getrefnumber は「完全展開可能」契約を維持するため、展開文脈でも
    % 安全な \detokenize による byte 列化のみを行う（アクティブ CJK byte
    % は \detokenize が展開せず string 化するため \csname 構成が安全に
    % なる。マクロ入り key は kernel の展開型照合でも元々非対称のため
    % 従来どおり）。eqref は \ref 経由のため重複 patch 不要。
    \@ifundefined{rc@set}{}{%
      % \refused（\ltx@IfUndefined{r@<key>} の生 key 照合）も正規化する
      \def\refused#1{%
        \pdftexja@labelkey{#1}%
        \expandafter\ifx\csname r@\pdftexja@labelkey@out\endcsname\relax
          \protect\G@refundefinedtrue
          \rc@WarningUndefined{#1}%
        \fi}%
      \def\rc@set#1#2#3#4{%
        \begingroup
          \csname @safe@activestrue\endcsname
          \refused{#4}%
          \pdftexja@labelkey{#4}%
          \expandafter\rc@@set
            \csname r@\pdftexja@labelkey@out\endcsname{#1}{#2}{#3}%
        \endgroup}%
    }%
    \@ifundefined{getrefnumber}{}{%
      % \getrefnumber は refcount の「完全展開可能」契約を維持する:
      % \detokenize は引数を展開せず string 化するため展開文脈で安全で、
      % アクティブ CJK byte の \csname 構成が成立する。
      % マクロ入り key は stock kernel/refcount の展開型照合でも書込側と
      % 非対称のため従来同等（ドキュメント化済みの境界）。
      \renewcommand*{\getrefnumber}[1]{%
        \romannumeral
        \expandafter\pdftexja@grn@e\expandafter{\detokenize{#1}}}%
      \def\pdftexja@grn@e#1{%
        \ltx@ifundefined{r@#1}{%
          \expandafter\ltx@zero\rc@default
        }{%
          \expandafter\expandafter\expandafter\rc@extract@
          \expandafter\expandafter\expandafter!%
          \csname r@#1\expandafter\endcsname
          \expandafter{\rc@default}\@nil
        }}%
    }%
    % cleveref: \cref の取得面 \cref@getref / \cpageref@getref と
    % 書込面（\newlabel{<key>@cref}）は cleveref の label hook 経由で
    % key が渡る。読み側の r@<key>@cref 構成を正規化 key で行う。
    \@ifundefined{cref@getref}{}{%
      % cleveref 内部の \edef\@tempa{#2}（key list 走査）がアクティブ CJK
      % byte を裸展開するため、\@cref の入口で key list を先に正規化する
      % （catcode 12 byte はそれ以降の cleveref 内部処理で展開されない）。
      % \cref@getref は正規化 key を受ける（再度の正規化は冪等）。
      % 書込面の \newlabel{<key>@cref} 行の byte 列と読込面の正規化 key は
      % 同一 byte になる（aux は生 byte、読みは catcode 12 の同一列）。
      \let\pdftexja@cref@orig@atcref\@cref%
      \def\@cref#1#2{%
        \pdftexja@labelkey{#2}%
        \edef\pdftexja@cref@call{%
          \noexpand\pdftexja@cref@orig@atcref{#1}{\pdftexja@labelkey@out}}%
        \pdftexja@cref@call}%
      % NOTE: "\csname r@\pdftexja@labelkey@out@cref" は @ が letter のため
      % 「out@cref」が単一の制御綴に融合する。接尾辞はマクロ経由で連結する。
      \def\pdftexja@cref@suffix{@cref}%
      \def\cref@getref#1#2{%
        \pdftexja@labelkey{#1}%
        \expandafter\let\expandafter#2%
          \csname r@\pdftexja@labelkey@out\pdftexja@cref@suffix\endcsname%
        \expandafter\expandafter\expandafter\def%
          \expandafter\expandafter\expandafter#2%
          \expandafter\expandafter\expandafter{%
            \expandafter\@firstoftwo#2}}%
      \def\cpageref@getref#1#2{%
        \pdftexja@labelkey{#1}%
        \expandafter\let\expandafter#2%
          \csname r@\pdftexja@labelkey@out\pdftexja@cref@suffix\endcsname%
        \expandafter\expandafter\expandafter\def%
          \expandafter\expandafter\expandafter#2%
          \expandafter\expandafter\expandafter{%
            \expandafter\@secondoftwo#2}}%
    }%
  }%


%. ------------------------------------------------ footnote marks (tate)
% pLaTeX (plcore) and LuaTeX-ja (lltjcore) set the footnote mark in tate as
% an upright (yoko) superscript, and the mark in the text takes no room
% along the line: it stands beside the preceding character (back .25zw,
% raised .9zh to the right of the column).  Yoko keeps the kernel's mark.
% Classes that define their own \@makefnmark later still override it.
\def\@makefnmark{\hbox{%
  \pdftexjaIfDirectionTF{tate}%
    {\pdftexjaBox{yoko}{\@textsuperscript{\normalfont\@thefnmark}}}%
    {\@textsuperscript{\normalfont\@thefnmark}}}}
\def\pdftexja@process@makefnmark#1{%
  \pdftexjaIfDirectionTF{tate}%
    {\hbox to\z@{\hskip-.25\zw\raise.9\zh#1\hss}}%
    {#1}}
\ifdefined\@kernel@process@makefnmark
  \let\pdftexja@orig@kernel@process@makefnmark\@kernel@process@makefnmark
  \def\@kernel@process@makefnmark#1{%
    \pdftexja@orig@kernel@process@makefnmark{\pdftexja@process@makefnmark{#1}}}
\else
  \def\pdftexja@tmp{\leavevmode
    \ifhmode\edef\@x@sf{\the\spacefactor}\nobreak\fi
    \@makefnmark
    \ifhmode\spacefactor\@x@sf\fi
    \relax}
  \ifx\@footnotemark\pdftexja@tmp
    \def\@footnotemark{\leavevmode
      \ifhmode\edef\@x@sf{\the\spacefactor}\nobreak\fi
      \pdftexja@process@makefnmark\@makefnmark
      \ifhmode\spacefactor\@x@sf\fi
      \relax}
  \else
    \PackageWarningNoLine{pdftexja}{\string\@footnotemark\space is not the
      kernel's; the tate footnote mark keeps its advance}
  \fi
\fi

\makeatother

\endinput

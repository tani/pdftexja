%%
%% Horizontal and vertical typesetting rules:
%%   - loads the generated JFM index + the yoko/tate payloads for the
%%     variant selected by the package's open-bracket-pos /
%%     hanging-punctuation options
%%   - per-character state machine on the CJK output layer:
%%     hooks the inner \CJKsymbol (both the plain and the punct route
%%     funnel through it under noCJKpunct) and the \CJK@ignorespaces
%%     token (post-glyph peek)
%%   - JFM pair glue (nat/str/shr in zw) between adjacent classes;
%%     undefined JA-JA pair -> \pdftexja@kanjiskip, undefined pair with
%%     a latin side (class 27) -> \pdftexja@xkanjiskip
%%   - JA<->LA boundary xspc rules (descriptor char policy)
%%   - kinsoku penalties (pre/post break 10000) by class
%%   - paragraph start resets the state to the JFM boundary class
%%     90 (parbdd); math counts as a latin (alchar) boundary
%%
%% This module also owns: priority glue, end_adjust line-end correction,
%% ratio blending of cross-JFM pairs, and the JFM data namespace:
%%   \pdftexja@data@<preset>@<variant>@<direction>@...
%% The active direction is selected by \pdftexja@data@prefix.
%%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pdftexja-rules}[2026/10/28 v0.1 pdftexja JFM rules]
\RequirePackage{graphicx}

\makeatletter
%. (kinsoku class tables live with the unified boundary emitter below;
%.  descriptor data overrides them when present.)

%. ------------------------------------------------------- JFM data load
% \pdftexja@jfm@load{<index basename>}:
%  (a) input the runtime index (metadata only: preset id, role classes,
%      kinsoku/xspacing/family/fullwidth-space tables),
%  (b) derive the variant id from the load-only package options:
%      base, then 'b' for hanging-punctuation, then 'z' for
%      zenkakunibu_nibu / 'n' for nibu_tentsuki (order b, then z/n), so
%      the ids are base, b, z, bz, n, bn,
%  (c) input BOTH direction payloads through the index's selection axis
%      (pdftexja-jfm-<id>-<yoko|tate>-<variant>.def),
%  (d) select the active direction + data prefix and build the runtime
%      codepoint dispatch tables for both directions.
% Missing data is an explicit error (no silent fallback).
\newcount\pdftexja@jfm@flags
\def\pdftexja@jfm@load#1{%
  \def\pdftexja@jfm@index{#1}%
  % the index may be given with or without its .def suffix
  \IfFileExists{\pdftexja@jfm@index.def}{%
    \typeout{pdftexja:~JFM~index~\pdftexja@jfm@index.def}%
    \input{\pdftexja@jfm@index.def}%
  }{%
    \IfFileExists{\pdftexja@jfm@index}{%
      \typeout{pdftexja:~JFM~index~\pdftexja@jfm@index}%
      \input{\pdftexja@jfm@index}%
    }{%
      \PackageError{pdftexja}{%
        JFM index file \pdftexja@jfm@index.def\space is missing}{%
        The~pdfTeX~JFM~index~for~the~selected~descriptor~is~not~installed.\MessageBreak
        Generate~the~runtime~JFM~data~with~`make~pdftex-jfm'.\MessageBreak
        \@ehc}%
    }%
  }%
  % (b) variant id: flags = 1 (hanging) + 2 (zenkakunibu_nibu) +
  % 4 (nibu_tentsuki); the 6 legal combinations are the 6 variants.
  \pdftexja@jfm@flags=0
  \ifnum\pdftexja@opt@hanging=1 \advance\pdftexja@jfm@flags\@ne \fi
  \ifnum\pdfstrcmp\expandafter{\pdftexja@opt@openbr}{zenkakunibu_nibu}=0 \relax
    \advance\pdftexja@jfm@flags\tw@
  \else
    \ifnum\pdfstrcmp\expandafter{\pdftexja@opt@openbr}{nibu_tentsuki}=0 \relax
      \advance\pdftexja@jfm@flags4\relax
    \fi
  \fi
  \ifcase\pdftexja@jfm@flags
    \def\pdftexja@jfm@variant{base}%
  \or \def\pdftexja@jfm@variant{b}%
  \or \def\pdftexja@jfm@variant{z}%
  \or \def\pdftexja@jfm@variant{bz}%
  \or \def\pdftexja@jfm@variant{n}%
  \or \def\pdftexja@jfm@variant{bn}%
  \else
    \PackageError{pdftexja}{invalid JFM variant selection}{%
      open-bracket-pos=hanging-punctuation~combination~is~not~a~known~JFM\MessageBreak
      variant.~Check~the~package~options.\MessageBreak
      \@ehc}%
    \def\pdftexja@jfm@variant{base}%
  \fi
  \@ifundefined{pdftexja@jfm@preset}{%
    \PackageError{pdftexja}{JFM index lacks \string\pdftexja@jfm@preset}{%
      The~loaded~JFM~index~does~not~identify~its~preset;~regenerate~it\MessageBreak
      with~`make~pdftex-jfm'.\MessageBreak
      \@ehc}%
    \def\pdftexja@jfm@preset{standard}%
  }{}%
  % every descriptor must have the four required roles
  \@for\pdftexja@role:=normal,latin,paragraph,box\do{%
    \expandafter\ifx\csname pdftexja@jfm@role@\pdftexja@role\endcsname\relax
      \PackageError{pdftexja}{JFM descriptor lacks the `\pdftexja@role' role}{%
        The~required~roles~normal/latin/paragraph/box~must~all~reference~an\MessageBreak
        existing~JFM~class.~Regenerate~the~descriptor/index.\MessageBreak
        \@ehc}%
    \fi}%
  % (c)+(d)
  \pdftexja@jfm@payload{yoko}%
  \pdftexja@jfm@payload{tate}%
  \pdftexja@jfm@tables{yoko}%
  \pdftexja@jfm@tables{tate}%
  % initial local direction / active data prefix (page conversion happens
  % only in the labelled begindocument/before hook)
  \pdftexja@setdir{\pdftexja@opt@dir}%
}
% one direction payload; #1 = yoko|tate.
% The index's selection axis maps (variant,direction) to the payload
% basename (pdftexja-jfm-<id>-<dir>-<variant>.def); a missing axis or
% missing file is an explicit error (no fallback to another variant).
\def\pdftexja@jfm@payload#1{%
  \expandafter\ifx
    \csname pdftexja@jfm@index@file@\pdftexja@jfm@variant @#1\endcsname
    \relax
    \PackageError{pdftexja}{JFM index has no payload for variant `%
      \pdftexja@jfm@variant' and direction `#1'}{%
      The~selected~open-bracket-pos/hanging-punctuation~combination~has~no\MessageBreak
      payload~in~this~descriptor.~Generate~the~runtime~JFM~data~with\MessageBreak
      `make~pdftex-jfm'.\MessageBreak
      \@ehc}%
  \else
    \edef\pdftexja@jfm@payload@file{%
      \csname pdftexja@jfm@index@file@\pdftexja@jfm@variant @#1\endcsname}%
    \IfFileExists{\pdftexja@jfm@payload@file}{%
      \typeout{pdftexja:~JFM~payload~\pdftexja@jfm@payload@file}%
      \input{\pdftexja@jfm@payload@file}%
    }{%
      \PackageError{pdftexja}{%
        JFM payload file \pdftexja@jfm@payload@file\space is missing}{%
        The~pdfTeX~JFM~payload~for~the~selected~variant~and~direction~is~not\MessageBreak
        installed.~Generate~the~runtime~JFM~data~with~`make~pdftex-jfm'.\MessageBreak
        \@ehc}%
    }%
  \fi
  \expandafter\edef\csname pdftexja@data@prefix@#1\endcsname{%
    \pdftexja@jfm@preset @\pdftexja@jfm@variant @#1}%
}
% per-direction runtime codepoint dispatch (decimal keys) built by
% re-keying the payload's chars@<n>/combo@<n> hex lists. Also installs
% the descriptor (direction-independent) kinsoku tables.
\def\pdftexja@jfm@tables#1{%
  \edef\pdftexja@data@prefix{\csname pdftexja@data@prefix@#1\endcsname}%
  \expandafter\ifx\csname pdftexja@data@\pdftexja@data@prefix @classlist\endcsname\relax
    \PackageError{pdftexja}{JFM payload lacks the class list}{%
      The~loaded~JFM~payload~has~no~\string\pdftexja@data@classlist.\MessageBreak
      Regenerate~it~with~`make~pdftex-jfm'.\MessageBreak
      \@ehc}%
    \def\pdftexja@classlist{0}%
  \else
    \edef\pdftexja@classlist{%
      \csname pdftexja@data@\pdftexja@data@prefix @classlist\endcsname}%
  \fi
  % build this direction's decimal codepoint dispatch (dcls@/combo@)
  \@for\pdftexja@cls:=\pdftexja@classlist\do{%
    \expandafter\pdftexja@loadclass\expandafter{\pdftexja@cls}%
  }%
  \pdftexja@units@update
}
% active direction setter: 0=yoko 1=tate (global; the factory and the
% page-direction stack re-seed the previous value themselves)
\def\pdftexja@setdir#1{%
  \global\pdftexja@dir=#1\relax
  \ifnum#1=1 \global\let\pdftexja@data@prefix\pdftexja@data@prefix@tate
  \else \global\let\pdftexja@data@prefix\pdftexja@data@prefix@yoko
  \fi
  % \zw/\zh are jfm.zw|zh x S of the ACTIVE direction (MIN/JIS zh<zw)
  \pdftexja@units@update}

%. ------------------------------------------------------- state machine
% Last-char-class state; values are the generated .def class numbers
% plus two synthetic states:
%   90 = paragraph/box boundary (JFM parbdd/boxbdd pseudo class; pair
%        90->1 is defined {0,0,0}, all other 90->c pairs are undefined
%        and fall back to \pdftexja@kanjiskip exactly as LuaTeX-ja does)
%   93 = explicit space seen (neutral: no boundary glue across a user
%        space, matching ltj's glue-node handling)
% 27 (latin run / math) is a real JFM class (alchar); pairs with 27
% define the JA<->LA glue, undefined 27 pairs fall back to
% \pdftexja@xkanjiskip.
% \global everywhere: the CJK layer expands inside {...} groups and the
% state must survive them.
\newcount\pdftexja@lastclass \global\pdftexja@lastclass=90
% class of the glyph being processed (scratch, global: hook bodies run
% inside the CJK decoder's own groups)
\newcount\pdftexja@curclass \global\pdftexja@curclass=0
% \inhibitglue interlock: 1 = suppress the next pair's glue (consumed
% ONCE by the emitter -- real one-boundary suppression semantics)
\newcount\pdftexja@inhibit \global\pdftexja@inhibit=0
% \inhibitglue: real one-boundary suppression. The NEXT eligible CJK
% boundary's JFM/auto skip is suppressed ONCE (the emitter consumes the
% flag at the first boundary it serves, including the CJK->LA boundary
% the peek machinery detects). Paragraph/box/math starts re-initialize
% the flag, so a stale token never leaks into a later paragraph.
\protected\def\inhibitglue{\global\pdftexja@inhibit=1 }
% pending post-break penalty of the previous glyph (half of the unified
% boundary penalty p = post(prev)+pre(next); the pre half is added at
% emission time and the SAME p is applied to every legal candidate)
\newcount\pdftexja@pend \global\pdftexja@pend=0
% pair glue scratch lengths (zw-scaled sp values)
\newdimen\pdftexja@nat
\newdimen\pdftexja@str
\newdimen\pdftexja@shr
% kanjiskip companion glue (separate node contribution)
\newdimen\pdftexja@knat
\newdimen\pdftexja@kstr
\newdimen\pdftexja@kshr
% codepoint scratch (decimal, from the CJK decoder)
\newcount\pdftexja@cp \global\pdftexja@cp=0
% zw of the glyph BEFORE / AT the current boundary (mixed-size blend:
% ltj-jfmglue.lua:812-857 blend_diffmet with the default
% diffmet_rule = two_paverage; both sides carry their own zw)
\newdimen\pdftexja@zw@prev \global\pdftexja@zw@prev=1pt
\newdimen\pdftexja@zw@cur  \global\pdftexja@zw@cur=1pt
% last observed CJK codepoint (scalar; -1 at paragraph/box boundaries).
% This IS the live \lastnodechar of this backend (pdftexja.sty
% aliases pdftexja@lastnodechar to the rules machinery; jlreq.cls
% reads it via \pdftexja@lastnodechar for \tatechuyoko etc.)
\newcount\pdftexja@lastnodechar \global\pdftexja@lastnodechar=-1
% per-boundary priority data (pdftexjaparagraph prerequisite): recorded
% at every pair emission so the strict-paragraph repack flow can
% read tier priorities without recomputing the lookup.
\newcount\pdftexja@pairspri
\newcount\pdftexja@pairshpri
% \pdftexja@pairspri/@pairshpri hold the pair's stretch / shrink
% priority (0 = plain finite glue); \pdftexja@knat/@kstr/@kshr
% hold the kanjiskip companion components (0 when the pair's
% kanjiskip_natural/stretch/shrink flags are 0). \pdftexja@nat/@str/
% @shr hold the JFM pair glue itself. The pdftexjaparagraph module
% reads these registers right after each boundary evaluation.
% Flag: when 1, \pdftexja@placeglyph boxes EVERY glyph (1zw classes
% too) -- set by the pdftexjaparagraph measurement so line interiors are
% fully walkable (boxes/glues/kerns/penalties only, no bare chars).
\newcount\pdftexja@boxglyphs \global\pdftexja@boxglyphs=0

%. --------------------------------------------------- semantic frames
% Box/paragraph boundaries must not inherit (nor leak) the running
% inter-glyph state. Two mechanisms, both WITHOUT
% \aftergroup (see the long comment below):
%   * ENTRY: everyhbox/everyvbox tokens (prepended; the user's own
%     tokens still run exactly once, after ours) neutralize the state
%     at box start (boxbdd semantics: 90/-1/0) so the glyph layer
%     inside starts from the neutral paragraph-boundary state. The
%     inhibit flag is preserved (one-shot semantics: \inhibitglue
%     issued just before a box must still suppress the first eligible
%     boundary INSIDE it). Backend-internal boxes (charbox, math
%     boxes, measurement boxes) bracket the guard count
%     \pdftexja@nest so this hook is a no-op inside them.
%   * CLOSE: no token is inserted. Reads that directly follow a box
%     (\lastnodetype 13/14 with the glyphmark below clear) re-apply
%     the same neutralization (boxbdd); the direction field of the
%     old frame tuple is gone (the factory and theindex switch
%     direction only inside nest-guarded boxes or outside boxes).
% NOTE: the old design saved the state at entry and
% restored it via \aftergroup\pdftexja@frame@pop at each box close.
% \aftergroup inserts real assignment tokens right after the box --
% and \leaders\hbox{...}<glue> REQUIRES the glue to follow the box
% with nothing unexpandable in between. Every leader box (LaTeX TOC
% dot leaders, user \leaders/\xleaders, \cleaders) therefore died
% with "Leaders not followed by proper glue" -- reproduced for
% yoko AND tate, with or without CJK in the leader box, with
% article+rules.sty alone (no output routine involved). The tate TOC
% pass-2 defect was exactly this, not a rotation problem. Candidate
% measured unusable: the quantity is not readable in restricted
% horizontal mode (\raise\hbox{}, math), so box entries there fail.
% The present design (neutralize at entry + boxbdd at reads +
% glyphmark to tell our own glyph boxes from user boxes) has the
% same observable boundary semantics and leaves leader scans clean.
%     glyphmark: 1 after each observed CJK glyph, 0 at each
%     (non-backend) box entry. The backend's own glyph boxes are
%     nest-guarded, so the mark distinguishes "\lastnodetype 13 is
%     our charbox" (mark=1, ordinary pair lookup) from "a user box
%     has just closed" (mark=0, boxbdd). Without the mark every tate
%     glyph (a rotated charbox, 13) would read as a box boundary.
\newcount\pdftexja@nest % backend-internal box guard (see glyph@tate/math)
\newcount\pdftexja@glyphmark \global\pdftexja@glyphmark=0
% Group-local direction enum, 0=yoko 1=tate, switched by the box
% factory / theindex pages; the glyph layer reads it via
% \pdftexja@ifydir/@iftdir. The MAIN document direction seeds it
% from the package's direction option at load time.
\newcount\pdftexja@dir \global\pdftexja@dir=0
% neutral box-start state (boxbdd semantics: 90, no pending penalty).
% Keep inhibit (see above); resync lastzw so the first interior
% boundary blends against the live glyph size.
\def\pdftexja@box@neutralize{%
  \global\pdftexja@lastclass=90
  \global\pdftexja@lastnodechar=-1
  \global\pdftexja@pend=0
  \global\pdftexja@lastzw=\pdftexja@jareg
  \global\pdftexja@glyphmark=0
}
% boxbdd re-neutralization at a read whose previous node is a closed
% USER box (\lastnodetype 13/14 and glyphmark=0): the pair is
% evaluated against the boundary pseudo class 90, not against the
% stale interior state -- pTeX box semantics (boxes isolate JFM
% state). Keep inhibit; resync lastzw.
\def\pdftexja@boxbdd{%
  \ifnum\pdftexja@glyphmark=0
    \ifnum\lastnodetype=13
      \pdftexja@boxbdd@
    \else
      \ifnum\lastnodetype=14
        \expandafter\pdftexja@boxbdd@
      \fi
    \fi
  \fi}
\def\pdftexja@boxbdd@{%
  \global\pdftexja@lastclass=90
  \global\pdftexja@lastnodechar=-1
  \global\pdftexja@pend=0
  \global\pdftexja@lastzw=\pdftexja@jareg
}
% consumer-side reader variant (\tatechuyoko / full-width-space):
% when the reader directly follows a closed user box, the observed
% lastnodechar must read as "no preceding char" (-1), matching the
% boxbdd semantics of the glyph-side reader above.
\def\pdftexja@boxbddlastchar{%
  \ifnum\pdftexja@glyphmark=0
    \ifnum\lastnodetype=13
      \global\pdftexja@lastnodechar=-1
    \else
      \ifnum\lastnodetype=14
        \global\pdftexja@lastnodechar=-1
      \fi
    \fi
  \fi}
% neutral paragraph start (everypar / para/begin / math entry): the
% boundary class, pending penalty, the last-node scalar and the
% inhibit flag reset; lastzw re-syncs to the CURRENT zw so the first
% boundary of the paragraph blends against the live glyph size (the
% init 1pt must not leak into the first pair's scaling -- the nibu
% 90->1 (-0.5zw) glue came out +1.75pt exactly that way).
\def\pdftexja@state@neutral{%
  \global\pdftexja@lastclass=90
  \global\pdftexja@lastnodechar=-1
  \global\pdftexja@pend=0
  \global\pdftexja@inhibit=0
  \global\pdftexja@lastzw=\pdftexja@jareg
  \global\pdftexja@glyphmark=0
}
% entry hook for everyhbox/everyvbox. NO \aftergroup (see the
% semantic-frames comment). Guard: no-op inside backend-internal
% construction.
\def\pdftexja@box@enter{%
  \ifnum\pdftexja@nest=0
    \pdftexja@box@neutralize
  \fi
}
%. --------------------------- unified boundary emitter
% One boundary = ONE emitter. It produces, between the previous glyph
% and the next glyph:
%   [end_adjust candidate series]   (only when the PREVIOUS class has
%      end_adjust data): for ascending candidates e_1..e_m (zw, kept
%      ASCENDING as the .def emits them, 0 included):
%        kern(e_1) penalty(p)
%        [kern(e_{i+1}-e_i) penalty(p)] ...
%        kern(-e_m) penalty(10000)
%      then the pair glue follows. A break at candidate i leaves the
%      cumulative kern (= e_i) on the line (PROTRUSION); a break at the
%      glue leaves net 0 (the series sums to zero) = the e=0 candidate.
%      The 0 candidate stays in the list; the glue itself remains the
%      final legal break (its break is the net-0/ordinary one) so no
%      duplicate break is created beyond that.
%      (Reference: ltj-adjust.lua:366-393 insert_lineend_kern,
%      extended mode; verified empirically that pdfTeX keeps the
%      preceding kerns on the broken line and drops the rest.)
%   [pair glue] nat/str/shr scaled by the blended zw + the kanjiskip
%      companion glue (separate node, from the CURRENT
%      \pdftexja@kanjiskip/\pdftexja@xkanjiskip per the pair's knat/kstr/kshr
%      flags).
% The single boundary penalty p = post(prev) + pre(next) is applied at
% every candidate (each candidate is a legal break). kinsoku-forbidden
% boundaries (p>=10000) emit the series too -- the candidates simply
% cannot be chosen -- and the pair glue keeps its stretch/shrink (no
% kern-ification; the old kernmode hack is gone).
\def\pdftexja@emitpair{%
  \ifnum\pdftexja@inhibit=1
    \global\pdftexja@inhibit=0
  \else
    \pdftexja@emitpair@xspc
  \fi
}
% xspc suppression:
%  latin -> CJK blocked when curclass is postonly (4)
%  CJK -> latin blocked when lastclass is preonly (9,10,11,15,16)
% Descriptor semantics: xsp@<class> = none|pre|post|both, where pre
% permits Latin->JA and post permits JA->Latin at this class.
%   Latin -> JA : pre of the (JA) current class
%   JA -> Latin : post of the (JA) previous class
\def\pdftexja@emitpair@xspc{%
  % \pdftexja@ifxsp sets \pdftexja@xspval=1 when the permission is GRANTED
  % (none=0, the other direction=0).  The boundary is emitted when granted;
  % the previous revision tested `=0' and therefore SUPPRESSED every permitted
  % boundary (measured: \hbox{漢$x$} lost its 0.25zw xkanjiskip and
  % \pdftexjaSetCharSpacing showed inverted widths).
  \ifnum\pdftexja@lastclass=27
    \pdftexja@ifxsp{pre}{\number\pdftexja@curclass}{\number\pdftexja@cp}%
    \ifnum\pdftexja@xspval=\@ne \pdftexja@emitpair@main \fi
  \else
    \ifnum\pdftexja@curclass=27
      \pdftexja@ifxsp{post}{\number\pdftexja@lastclass}{\number\pdftexja@lastnodechar}%
      \ifnum\pdftexja@xspval=\@ne \pdftexja@emitpair@main \fi
    \else
      \pdftexja@emitpair@main
    \fi
  \fi
}
% main: evaluate the pair (9 fields, live fallback) then emit.
% jidorimode (字取り/空き組み) replaces the pair glue as before.
\def\pdftexja@emitpair@main{%
  \ifnum\pdftexja@lastclass=93
    % explicit space between: no boundary glue (ltj: glue pseudo-char)
  \else
    \ifnum\pdftexja@jidorimode>0
      \ifnum\pdftexja@lastclass=90
        % 行頭相当（box先頭）: グルーなし
      \else
        \ifnum\pdftexja@jidorimode=2
          \hskip 0pt plus 1fil\relax
        \else
          \hskip\pdftexja@akiskip
        \fi
      \fi
    \else
      \pdftexja@evalpair
      \pdftexja@emitboundary
    \fi
  \fi
}
% ---- pair evaluation (shared by the emitter, calc@jfmglue and the
% strict paragraph module) --
% Sets: \pdftexja@nat/@str/@shr (pair glue, sp), \pdftexja@knat/@kstr/
% @kshr (kanjiskip companion components, sp; 0 when no companion),
% \pdftexja@pairspri/@pairshpri (tier priorities for the strict
% paragraph module), and the blended zw pair used for the scaling.
% Lookup key:
% \pdftexja@jfm@pair@<lastclass>@<curclass>.
%  - defined pair: all 9 fields evaluated. nat/str/shr are in zw units;
%    with different zw on the two sides (mixed font sizes) each
%    component x is realized as the ltj average blend
%      b_val = (1-r_b) x zw_prev + r_b x zw_cur
%      a_val = (1-r_a) x zw_prev + r_a x zw_cur
%      val   = (b_val + a_val)/2       (diffmet_rule = two_paverage,
%                                      ltj-jfmglue.lua:157,812-824)
%    where r_b/r_a are the pair's ratio (field 4; 0.5 default).
%  - undefined pair: fallback = the CURRENT \pdftexja@kanjiskip (JA-JA) /
%    \pdftexja@xkanjiskip (latin side) glue spec, parsed live (no fixed
%    constants). The companion is the full (x)kanjiskip glue in this
%    case (ltj: `if not g then g = get_(x)kanjiskip').
\newcount\pdftexja@jidorimode \global\pdftexja@jidorimode=0
\newskip\pdftexja@akiskip
\newdimen\pdftexja@parratio
\def\pdftexja@evalpair{%
  \edef\pdftexja@pairname{%
    pdftexja@data@\pdftexja@data@prefix @pair@\number\pdftexja@lastclass
    @\number\pdftexja@curclass}%
  \expandafter\ifx\csname\pdftexja@pairname\endcsname\relax
    \pdftexja@evalpair@fallback
  \else
    \global\pdftexja@zw@prev=\pdftexja@lastzw
    \global\pdftexja@zw@cur=\pdftexja@jareg
    \global\pdftexja@fbmode=0
    \csname\pdftexja@pairname\endcsname
    \global\pdftexja@lastzw=\pdftexja@zw@cur
  \fi
}
% \pdftexja@lastzw: zw in effect when the PREVIOUS glyph was placed
% (font-size changes between glyphs change \pdftexja@jareg AFTER the glyph;
% record it at each glyph observation -- \pdftexja@pre does this).
\newdimen\pdftexja@lastzw \global\pdftexja@lastzw=10pt
% live fallback: the CURRENT \pdftexja@kanjiskip / \pdftexja@xkanjiskip glue
% SPEC (verbatim, orders preserved -- no fixed constants). Since the
% fallback glue IS the full skip, it is emitted verbatim via
% \pdftexja@fbmode: emitglue then does `\hskip\pdftexja@fbskip'.
% (Decomposing `\the<skip>' into a dimen would leak the ` plus...'
% tokens into the stream and lose fil orders; the verbatim skip keeps
% both exact.)
\newskip\pdftexja@fbskip
\newcount\pdftexja@fbmode % 1 = fallback: emit \pdftexja@fbskip verbatim
\def\pdftexja@evalpair@fallback{%
  \global\pdftexja@zw@prev=\pdftexja@lastzw
  \global\pdftexja@zw@cur=\pdftexja@jareg
  \global\pdftexja@fbmode=1
  \ifnum\pdftexja@lastclass=27 \pdftexja@fbskip=\pdftexja@xkanjiskip
  \else\ifnum\pdftexja@curclass=27 \pdftexja@fbskip=\pdftexja@xkanjiskip
  \else \pdftexja@fbskip=\pdftexja@kanjiskip
  \fi\fi
  \global\pdftexja@lastzw=\pdftexja@zw@cur
  % fallback = the full skip: it IS the pair glue; no separate companion
  \global\pdftexja@knat=0pt
  \global\pdftexja@kstr=0pt
  \global\pdftexja@kshr=0pt
  \global\pdftexja@pairspri=0
  \global\pdftexja@pairshpri=0
}
% pairfields: evaluate ALL NINE fields. #1..#3 nat/str/
% shr (zw), #4 ratio, #5 spri, #6 shpri, #7 knat, #8 kstr, #9 kshr.
% The zw scaling uses the two_paverage blend of the prev/cur zw; with
\def\pdftexja@pairfields#1#2#3#4#5#6#7#8#9{%
  \pdftexja@parratio=#4pt\relax % ratio as a pt-dimen: 0.500000 -> 0.5pt
  \pdftexja@blendzw{#1}\pdftexja@nat
  \pdftexja@blendzw{#2}\pdftexja@str
  \pdftexja@blendzw{#3}\pdftexja@shr
  \global\pdftexja@pairspri=#5\relax
  \global\pdftexja@pairshpri=#6\relax
  % kanjiskip companion: a SEPARATE glue node derived from the CURRENT
  % \pdftexja@kanjiskip (its natural/stretch/shrink), gated by the pair's
  % knat/kstr/kshr flags (ltj get_kanjiskip_low(flag=true,...)):
  %   knat=1 -> companion natural = kanjiskip natural, etc.
  % Natural extraction: `\the<skip>' expands to the FULL glue spec
  % ("0.0pt plus 2.5pt...") and a dimen assignment would leak the
  % ` plus...' tokens into the stream -- so the natural is split off
  % via the space-delimited \pdftexja@ksnatsplit (see below; glue
  % naturals are always finite; stretch/shrink are read directly via
  % \gluestretch/\glueshrink).
  \pdftexja@fbskip=\pdftexja@kanjiskip\relax
  \ifnum#7=1
    \edef\pdftexja@ksnattext{\the\pdftexja@fbskip}%
    \edef\pdftexja@ksnat{\expandafter\pdftexja@ksnatsplit\pdftexja@ksnattext\relax}%
    \global\pdftexja@knat=\pdftexja@ksnat\relax
  \else \global\pdftexja@knat=0pt \fi
  \ifnum#8=1 \global\pdftexja@kstr=\gluestretch\pdftexja@fbskip
  \else \global\pdftexja@kstr=0pt \fi
  \ifnum#9=1 \global\pdftexja@kshr=\glueshrink\pdftexja@fbskip
  \else \global\pdftexja@kshr=0pt \fi
}
% Kanjiskip-natural extraction: `\the<skip>' is "3.0pt plus 2.5pt..."
% with catcode-12 `pt' -- a delimited split on file-text `pt' can
% never match (that catcode mismatch was the "extra }" bug). Split on
% the first SPACE instead (space tokens keep catcode 10 through
% \edef): "0.0pt plus 2.5pt..." -> "0.0pt" (glue naturals are always
% finite; fil orders live only in the plus/minus parts, which are
% read separately via \gluestretch/\glueshrink).
\def\pdftexja@ksnatsplit#1 #2\relax{#1}

% ------------------------------------------- data-namespace pair bodies
% Generated pair payloads call one of these two with their fields; both
% fill the SAME scratch registers \pdftexja@pairfields sets, so the
% evaluator/emitter never needs to know the payload's record kind.
\def\pdftexja@data@glue#1#2#3#4#5#6#7#8#9{%
  \pdftexja@pairfields{#1}{#2}{#3}{#4}{#5}{#6}{#7}{#8}{#9}}
% kern record: amount (zw coefficient) + ratio; no companion, no
% priority (a defined kern keeps its node even at amount 0)
\def\pdftexja@data@kern#1#2{%
  \pdftexja@parratio=#2pt\relax
  \pdftexja@blendzw{#1}\pdftexja@nat
  \pdftexja@str=\z@ \pdftexja@shr=\z@
  \global\pdftexja@pairspri=\z@ \global\pdftexja@pairshpri=\z@
  \global\pdftexja@knat=\z@ \global\pdftexja@kstr=\z@
  \global\pdftexja@kshr=\z@}
% blendzw{<zw-number>}{<target dimen>}: target = x * blended zw with
%   ltj-jfmglue.lua:812-857; b == a here because both sides share the
%   single jlreq JFM and its ratio, so the average halves b).
% \pdftexja@parratio holds r as a pt-dimen (0.500000 -> 0.5pt).
% sp^2 products overflow \dimexpr for glyph-sized inputs, so the blend
% is assembled with \advance: b = zw_prev + r*(zw_cur - zw_prev)
% (the delta is at most one glyph size, so the product stays small).
\def\pdftexja@blendzw#1#2{%
  \pdftexja@tmpa=\pdftexja@zw@cur
  \advance\pdftexja@tmpa-\pdftexja@zw@prev
  % dimen*dimen = sp^2; /65536 (plain integer, NO unit keyword --
  % `\dimexpr../65536pt' leaks the `pt' tokens) gives sp:
  %   r (pt-dimen) * delta / 1pt = r*delta
  \pdftexja@tmpa=\dimexpr\pdftexja@parratio*\pdftexja@tmpa/65536\relax
  \advance\pdftexja@tmpa\pdftexja@zw@prev
  % tmpa = b (blended zw); result = x * b  (x = #1, a plain coefficient)
  #2=\dimexpr#1\pdftexja@tmpa\relax
}
% ---- the emission itself ---------------------------------------------
% p = post(prev) + pre(next) -- ONE penalty value for the whole boundary.
% NOTE: dedicated registers only -- this runs INSIDE the CJK decoder
% (\@tempcnta carries the codepoint there; clobbering it produced
% "Bad character code" and corrupted glyphs).
\newcount\pdftexja@bpen
\def\pdftexja@boundaryp{%
  \pdftexja@bpen=0
  \pdftexja@getkin{post}{\number\pdftexja@lastclass}%
  \advance\pdftexja@bpen\pdftexja@kinval
  \pdftexja@getkin{pre}{\number\pdftexja@curclass}%
  \advance\pdftexja@bpen\pdftexja@kinval
}
% end_adjust candidate walker state
\newbox\pdftexja@charbox
\newdimen\pdftexja@tmpa
\newdimen\pdftexja@eaval
\newdimen\pdftexja@eaprev
\def\pdftexja@emitboundary{%
  \pdftexja@boundaryp
  \expandafter\ifx\csname pdftexja@data@\pdftexja@data@prefix @endadj@\number\pdftexja@lastclass\endcsname\relax
    % no end_adjust data: the plain boundary -- one penalty + glue
    \ifnum\pdftexja@bpen>0 \penalty\pdftexja@bpen \fi
    \pdftexja@emitglue
  \else
    % candidate series (ascending e_1..e_m; 0 kept in the list).
    % NOTE the #1 indirection: `\expandafter\pdftexja@eawalk\csname...'
    % would hand the ENDADJ MACRO TOKEN to eawalk (an undelimited
    % argument takes a control sequence as one token); the wrapper's
    % `\expandafter...#1' expands the macro first so the walker sees
    % the brace-group FIELDS one by one.
    \pdftexja@eaprev=0pt
    \expandafter\pdftexja@easeries
      \csname pdftexja@data@\pdftexja@data@prefix @endadj@\number\pdftexja@lastclass\endcsname
  \fi
}
\def\pdftexja@easeries#1{\expandafter\pdftexja@eawalk#1\pdftexja@eaend}
% eawalk{<e_i>}: emit kern(e_i - e_{i-1}) [penalty(p) kern(...)] ...
% series layout (first candidate: kern(e_1) then penalty(p)):
%   kern(e_1) penalty(p) kern(e_2-e_1) penalty(p) ... kern(e_m-e_{m-1})
%   penalty(p) kern(-e_m) penalty(10000)  THEN the pair glue.
\def\pdftexja@eawalk#1{%
  \def\pdftexja@eafield{#1}%
  \ifx\pdftexja@eafield\pdftexja@eaendmark
    % finish: undo kern + close the series, THEN the pair glue
    % (the glue break after penalty(10000) is the net-0/e=0 legal
    % break; the series sums to zero so a glue break leaves e=0)
    \kern-\pdftexja@eaprev
    \penalty10000
    \pdftexja@emitglue
    \expandafter\@gobble
  \else
    \pdftexja@eaval=#1\pdftexja@zw@prev\relax
    \ifdim\pdftexja@eaprev=0pt
      \kern\pdftexja@eaval
    \else
      \kern\dimexpr\pdftexja@eaval-\pdftexja@eaprev\relax
    \fi
    \ifnum\pdftexja@bpen>0 \penalty\pdftexja@bpen \else \penalty0 \fi
    \pdftexja@eaprev=\pdftexja@eaval
    \expandafter\@firstofone
  \fi
  {\pdftexja@eawalk}%
}
\def\pdftexja@eaendmark{\pdftexja@eaend}
\def\pdftexja@eaend{\pdftexja@eaend}
% the pair glue + kanjiskip companion emission.
% Fallback (fbmode=1): the CURRENT (x)kanjiskip glue verbatim (orders
% preserved). Defined pair: nat/str/shr (finite, zw-scaled) + the
% kanjiskip companion as its own glue node when any component is
% nonzero (ltj real_insert(k)). All-zero pair glue emits nothing
% (keeps the node stream lean; the candidate series already ended
% with penalty(10000) so no break is lost).
\def\pdftexja@emitglue{%
  \ifnum\pdftexja@fbmode=1
    \hskip\pdftexja@fbskip
  \else
    \ifdim\pdftexja@nat=0pt
      \ifdim\pdftexja@str=0pt
        \ifdim\pdftexja@shr=0pt
        \else \pdftexja@emitglue@do
        \fi
      \else \pdftexja@emitglue@do
      \fi
    \else \pdftexja@emitglue@do
    \fi
  \fi
  \ifdim\pdftexja@knat=0pt
    \ifdim\pdftexja@kstr=0pt
      \ifdim\pdftexja@kshr=0pt
      \else \pdftexja@emitkcomp
      \fi
    \else \pdftexja@emitkcomp
    \fi
  \else \pdftexja@emitkcomp
  \fi
}
\def\pdftexja@emitglue@do{%
  \hskip\pdftexja@nat
  \ifdim\pdftexja@str>0pt plus\pdftexja@str\fi
  \ifdim\pdftexja@shr>0pt minus\pdftexja@shr\fi
}
\def\pdftexja@emitkcomp{%
  \hskip\pdftexja@knat
  \ifdim\pdftexja@kstr>0pt plus\pdftexja@kstr\fi
  \ifdim\pdftexja@kshr>0pt minus\pdftexja@kshr\fi
}

%. -------------------------------- kinsoku per-class penalty tables
% The penalties are DESCRIPTOR data: the JFM index emits
% \pdftexja@jfm@kin@pre@<class> / \pdftexja@jfm@kin@post@<class> for
% every class (0 when the class has no prohibition). No built-in class
% table exists in the runtime; a missing entry reads as 0.
\newcount\pdftexja@kinval
\def\pdftexja@getkin#1#2{% #1=pre|post, #2=class -> \pdftexja@kinval
  \expandafter\ifx\csname pdftexja@jfm@kin@#1@#2\endcsname\relax
    \pdftexja@kinval=\z@
  \else
    \pdftexja@kinval=\csname pdftexja@jfm@kin@#1@#2\endcsname\relax
  \fi}
% Latin<->JA xspacing permission.
% Lookup order (plan §5.3): PUBLIC SCALAR OVERRIDE -> descriptor class map
% \pdftexja@jfm@xsp@<class> -> class default -> both.
% #1=pre (Latin->JA) | post (JA->Latin); #2=class; #3=scalar (decimal) of
% the JA side.  Scalar overrides are created by
% \pdftexjaSetCharSpacing{<HEX>}{none|pre|post|both}.
\newcount\pdftexja@xspval
\newcount\pdftexja@xsp@scalar
\def\pdftexja@ifxsp#1#2#3{%
  \pdftexja@xspval=\z@
  \pdftexja@xsp@scalar=#3\relax
  \expandafter\ifx\csname pdftexja@charxsp@\number\pdftexja@xsp@scalar\endcsname\relax
    \pdftexja@ifxsp@class{#1}{#2}%
  \else
    \pdftexja@ifxsp@value{#1}{\csname pdftexja@charxsp@\number\pdftexja@xsp@scalar\endcsname}%
  \fi}
\def\pdftexja@ifxsp@class#1#2{%
  \expandafter\ifx\csname pdftexja@jfm@xsp@#2\endcsname\relax
    \pdftexja@xspval=\@ne
  \else
    \pdftexja@ifxsp@value{#1}{\csname pdftexja@jfm@xsp@#2\endcsname}%
  \fi}
% \pdftexjaSetCharSpacing{<HEX scalar>}{none|pre|post|both} (plan §5.3):
% per-scalar Latin<->JA spacing permission.  Preamble-only, prefix-free HEX
% (no 0x), surrogate range rejected, unknown mode rejected, later calls
% replace an earlier entry, TeX-group-local, direction/family independent.
% It never touches classification, penalties or encoding.  Only meaningful
% for boundary_semantics=jfm descriptors: for the existing/JLReq evaluator
% it is an explicit unsupported error (never a silent no-op).
\def\pdftexjaSetCharSpacing#1#2{%
  \ifpdftexja@afterpreamble
    \PackageError{pdftexja}{\string\pdftexjaSetCharSpacing\space is preamble-only}{%
      Per-scalar spacing permissions select boundary behaviour and must be\MessageBreak
      declared before the document starts.\MessageBreak \@ehc}%
  \fi
  \ifnum\pdfstrcmp{\pdftexja@jfm@boundarysemantics}{jfm}=0 
    \pdftexja@setcharspacing{#1}{#2}%
  \else
    \PackageError{pdftexja}{\string\pdftexjaSetCharSpacing\space needs a jfm-semantics JFM}{%
      The~loaded~JFM~descriptor~keeps~the~existing~JLReq~boundary~evaluator,\MessageBreak
      where~per-scalar~permissions~have~no~meaning.~Use~a~descriptor~with\MessageBreak
      boundary_semantics=jfm,~or~leave~the~policy~to~the~descriptor.\MessageBreak
      \@ehc}%
  \fi}
\def\pdftexja@setcharspacing#1#2{%
  % --- HEX validation (2..6 digits, no prefix, no sign) ---
  \pdftexja@csp@validate{#1}
  % --- mode validation ---
  \ifnum\pdfstrcmp{#2}{none}=0  \else
  \ifnum\pdfstrcmp{#2}{pre}=0  \else
  \ifnum\pdfstrcmp{#2}{post}=0  \else
  \ifnum\pdfstrcmp{#2}{both}=0  \else
    \PackageError{pdftexja}{invalid char spacing mode `#2'}{%
      Use~none,~pre,~post~or~both.\MessageBreak \@ehc}%
  \fi\fi\fi\fi
  % --- surrogate range: a scalar override on U+D800..U+DFFF is meaningless ---
  % (\pdftexja@hextodec already ran in \pdftexja@csp@validate)
  \ifnum\pdftexja@hexacc>"D7FF\relax
    \ifnum\pdftexja@hexacc<"E000\relax
      \PackageError{pdftexja}{surrogate scalar `#1' cannot carry a spacing policy}{%
        Surrogate code points are not characters; use the scalar they encode.\MessageBreak
        \@ehc}%
    \fi
  \fi
  \expandafter\def\csname pdftexja@charxsp@\number\pdftexja@hexacc\endcsname{#2}%
}
% HEX validation is done by \pdftexja@hextodec itself: it reports an
% invalid digit in \pdftexja@hex@bad and counts digits in \pdftexja@hex@len,
% so the setter does not need a second token walker (which would re-introduce
% the brace-vs-token ambiguity that already broke one attempt).
\def\pdftexja@csp@validate#1{%
  \pdftexja@hextodec{#1}%
  \ifnum\pdftexja@hex@bad=\z@
    \ifnum\pdftexja@hex@len>1
      \ifnum\pdftexja@hex@len<7
      \else \pdftexja@csp@badhex \fi
    \else \pdftexja@csp@badhex \fi
  \else \pdftexja@csp@badhex \fi}
\def\pdftexja@csp@badhex{%
  \PackageError{pdftexja}{invalid HEX scalar}{%
    Give~the~Unicode~scalar~as~2..6~hexadecimal~digits~without~a~prefix,\MessageBreak
    e.g.~0028~or~3012.\MessageBreak \@ehc}}

% \pdftexja@ifxsp@value{pre|post}{<mode token list>}: none=0, both=1,
% the requested permission=1, the other permission=0.
\def\pdftexja@ifxsp@value#1#2{%
  \ifnum\pdfstrcmp{#2}{none}=0 \relax
  \else
    \ifnum\pdfstrcmp{#2}{both}=0 \relax
      \pdftexja@xspval=\@ne
    \else
      \ifnum\pdfstrcmp{#2}{#1}=0 \relax
        \pdftexja@xspval=\@ne
      \fi
    \fi
  \fi}

%. ------------------------------------------------ post-break scratch
% (kept for external probes/tests; the emitter now computes p on the
% fly via \pdftexja@boundaryp, and \pdftexja@setpost below only records
% the class of the glyph just placed for \lastnodechar maintenance)
\def\pdftexja@setpost{%
  \global\pdftexja@lastnodechar=\pdftexja@cp
}

%. ----------------------------- hanging (negative end_adjust path)
% ぶら下げ（hanging_punctuation, -b 変種）はクラス6/7の end_adjust
% 候補 {-0.5, 0, 0.5}（zw）の「負候補」として同じ候補列で表現される。
% 行末で break が負候補 e=-0.5zw を選ぶと行は 0.5zw 突き出す。
% したがって:
%   - 裸字形専用分岐 (hangglyph), 負 hangkern, \rpcode 設定,
%     \pdfprotrudechars 変更 — すべて撤去 (JFM幅付き字形boxが標準)
%   - microtype との二重調整: 本バックエンドは \rpcode を一切設定
%     しない（microtype 既定の欧文 protrusion には触れない。欧文以外
%     のslotへ protrusion を設定するのは microtype 自身の設定次第で
%     あり、ここでは干渉しない — コメントとしての明記のみ）。
%   - 通常段落の末尾（para/end）: 最終和文字クラスに負の最小
%     end_adjust があれば、その tail kern (e_min) を parfillskip の
%     前へ挿入する（短い最終行を無理に両端揃えしない）。
%     ltj insert_lineend_kern_tail (ltj-adjust.lua:397-411) 相当。
\newdimen\pdftexja@tailkern
\def\pdftexja@para@endhook{%
  % If the paragraph's last node is a box, the tail-kern read
  % must use boxbdd semantics (no stale interior end_adjust).
  \pdftexja@boxbdd
  % inside the paragraph, before \parfillskip is added: if the last
  % observed CJK class has a negative minimal end_adjust candidate,
  % insert its kern so the final short line keeps the protrusion.
  \expandafter\ifx\csname pdftexja@data@\pdftexja@data@prefix @endadj@\number\pdftexja@lastclass\endcsname\relax
  \else
    \pdftexja@tailkern=0pt
    % the #1 wrapper expands the endadj macro first (the same
    % undelimited-argument rule as \pdftexja@easeries -- see there)
    \expandafter\pdftexja@tailseries
      \csname pdftexja@data@\pdftexja@data@prefix @endadj@\number\pdftexja@lastclass\endcsname
    \ifdim\pdftexja@tailkern<0pt \kern\pdftexja@tailkern \fi
  \fi
}
\def\pdftexja@tailseries#1{\expandafter\pdftexja@tailwalk#1\pdftexja@eaend}
\def\pdftexja@tailwalk#1{%
  \def\pdftexja@eafield{#1}%
  \ifx\pdftexja@eafield\pdftexja@eaendmark
    \expandafter\@gobble
  \else
    \pdftexja@eaval=#1\pdftexja@zw@cur\relax
    \ifdim\pdftexja@eaval<\pdftexja@tailkern
      \pdftexja@tailkern=\pdftexja@eaval
    \fi
    \expandafter\@firstofone
  \fi
  {\pdftexja@tailwalk}%
}

%. ------------------------------------------------- codepoint -> class
% The hooks receive the DECIMAL codepoint; the .def dispatch is keyed
% by hex. Rather than converting per character at runtime, the whole
% dispatch is re-keyed to decimal names ONCE here at load time:
%   \pdftexja@dcls@<decimal>  = class number.
% The hex keys are enumerated from the per-class chars@<n> lists of
% the loaded .def (U+XXXX entries; AJ1-<gid> entries are pTeX/VF-only
% and have no codepoint -- skipped). The combo lists (comma groups)
% are parsed too: the trailing codepoint of each combo is recorded in
% \pdftexja@combomarks so the runtime treats it as an attaching mark
% (no pair glue, no state update).
\newcount\pdftexja@cnta
\newcount\pdftexja@cntb
\newcount\pdftexja@hexacc
% instrumentation for callers that must validate the input (the public
% \pdftexjaSetCharSpacing API): 0/1 flag + digit count, reset per call.
\newcount\pdftexja@hex@bad
\newcount\pdftexja@hex@len
% hex -> decimal: \pdftexja@hextodec{<hexdigits>} sets \pdftexja@hexacc
\def\pdftexja@hextodec#1{%
  \global\pdftexja@hexacc=0
  \global\pdftexja@hex@bad=0
  \global\pdftexja@hex@len=0
  \pdftexja@hextodec@a#1\pdftexja@htx@end
}
\def\pdftexja@hextodec@a#1{%
  \def\pdftexja@hxt{#1}%
  \ifx\pdftexja@hxt\pdftexja@htx@end
  \else
    {\pdftexja@cnta=`#1\relax
     \ifnum\pdftexja@cnta>"2F\relax
       \ifnum\pdftexja@hex@bad=\z@
         \ifnum\pdftexja@cnta>"2F\relax
           \ifnum\pdftexja@cnta<"3A\relax
           \else
             \ifnum\pdftexja@cnta>"40\relax
               \ifnum\pdftexja@cnta<"47\relax
               \else
                 \ifnum\pdftexja@cnta>"60\relax
                   \ifnum\pdftexja@cnta<"67\relax
                   \else \global\pdftexja@hex@bad=1 \fi
                 \else \global\pdftexja@hex@bad=1 \fi
               \fi
             \else \global\pdftexja@hex@bad=1 \fi
           \fi
         \fi
       \fi
     \else \global\pdftexja@hex@bad=1 \fi
     \global\advance\pdftexja@hex@len\@ne
     \ifnum\pdftexja@cnta>96 \advance\pdftexja@cnta-87 % a-f -> 10..15
     \else\ifnum\pdftexja@cnta>64 \advance\pdftexja@cnta-55 % A-F
     \else\advance\pdftexja@cnta-48 % 0-9
     \fi\fi
     \global\multiply\pdftexja@hexacc16
     \global\advance\pdftexja@hexacc\pdftexja@cnta}%
    \expandafter\pdftexja@hextodec@a
  \fi
}
\def\pdftexja@htx@end{\pdftexja@htx@end}%

% The class list comes from the payload of the ACTIVE direction
% (\pdftexja@data@...@classlist). \pdftexja@jfm@tables sets
% \pdftexja@classlist per direction before calling the re-key walk.
% Load-time re-key of the dispatch into decimal names, per direction,
% plus the combo trailing-mark table (plain TeX/LaTeX2e only: the
% backend's \RequirePackage{expl3} leaves the ambient \ExplSyntaxOn
% regime unreliable mid-class, so this file avoids expl3 runtime
% functions). The direction is part of the runtime name, so switching
% the active prefix needs no re-key:
%   \pdftexja@data@<prefix>@dcls@<decimal>  = class number
%   \pdftexja@data@<prefix>@combo@<decimal> = 1  (attaching mark)
\def\pdftexja@loadentry#1#2{% <entry> <class>
  \def\pdftexja@loadentry@com##1,##2\pdftexja@htx@end{%
    \def\pdftexja@loadentry@a{##1}\def\pdftexja@loadentry@b{##2}}%
  \expandafter\pdftexja@loadentry@com#1,\pdftexja@htx@end
  \expandafter\pdftexja@ajtest\pdftexja@loadentry@a\@nil
  \ifnum\pdftexja@ajflag=1 %
    % AJ1-<gid> entries are pTeX/VF-only: no codepoint, skip
  \else
    \ifx\pdftexja@loadentry@b\@empty
      \expandafter\pdftexja@regsingle\pdftexja@loadentry@a
        \pdftexja@htx@end{#2}%
    \else
      \expandafter\pdftexja@regcombo\pdftexja@loadentry@b
        \pdftexja@htx@end
    \fi
  \fi
}
% #1 = hex digits (variable length), #2 = class (for regsingle)
\def\pdftexja@ajtest#1#2#3#4\@nil{%
  \global\pdftexja@ajflag=0
  \def\pdftexja@ajfirst{#1}%
  \def\pdftexja@ajmark{A}%
  \ifx\pdftexja@ajfirst\pdftexja@ajmark
    \def\pdftexja@ajsecond{#2}%
    \def\pdftexja@ajmark{J}%
    \ifx\pdftexja@ajsecond\pdftexja@ajmark
      \global\pdftexja@ajflag=1
    \fi
  \fi
}%
\newcount\pdftexja@ajflag
\def\pdftexja@regsingle U+#1\pdftexja@htx@end#2{%
  \pdftexja@hextodec{#1}%
  \expandafter\xdef\csname pdftexja@data@\pdftexja@data@prefix @dcls@\number\pdftexja@hexacc\endcsname{#2}%
}
\def\pdftexja@regcombo U+#1\pdftexja@htx@end{%
  \pdftexja@hextodec{#1}%
  \expandafter\xdef\csname pdftexja@data@\pdftexja@data@prefix @combo@\number\pdftexja@hexacc\endcsname{1}%
}
\def\pdftexja@walklist#1#2{% <chars|combo> <class>
  \expandafter\ifx\csname pdftexja@data@\pdftexja@data@prefix @#1@#2\endcsname\relax
  \else
    \edef\pdftexja@tempa{\csname pdftexja@data@\pdftexja@data@prefix @#1@#2\endcsname\space}%
    \expandafter\pdftexja@walk@a\pdftexja@tempa\pdftexja@htx@end{#2}%
  \fi
}
\def\pdftexja@walk@a#1 #2\pdftexja@htx@end#3{%
  \def\pdftexja@item{#1}%
  \ifx\pdftexja@item\@empty
    % list exhausted (the trailing space we append)
  \else
    \pdftexja@loadentry{#1}{#3}%
    \pdftexja@walk@a#2 \pdftexja@htx@end{#3}%
  \fi
}
\def\pdftexja@loadclass#1{%
  \pdftexja@walklist{chars}{#1}%
  \pdftexja@walklist{combo}{#1}%
}
%. ------------------------------------------------------ runtime lookup
% \pdftexja@setclassof{<byte>}: CJK.sty の内部 \CJKsymbol は
% 「\CJK@plane（16進2桁のプレーン接頭）×256 + バイト値」形式で文字を渡す
% （例: 「= U+300C → plane "30", byte 12 → 0x30*256+12 = 12300）。
% Unicodeコードポイントを復元してからクラス表を引く。
% （undefined codepoint => class 0 = default CJK, as in the JFM.）
\def\pdftexja@setclassof#1{%
  \expandafter\pdftexja@hextodec\expandafter{\CJK@plane}
  \global\pdftexja@cp=\pdftexja@hexacc
  \multiply\pdftexja@cp256
  \advance\pdftexja@cp#1\relax
  \expandafter\ifx\csname pdftexja@data@\pdftexja@data@prefix @combo@\number\pdftexja@cp\endcsname\relax
    \expandafter\ifx\csname pdftexja@data@\pdftexja@data@prefix @dcls@\number\pdftexja@cp\endcsname\relax
      \global\pdftexja@curclass=0
    \else
      \global\pdftexja@curclass=\csname pdftexja@data@\pdftexja@data@prefix @dcls@\number\pdftexja@cp\endcsname\relax
    \fi
  \else
    % 接着記（combo後続コードポイント，例: U+309A）: 前クラス維持・無出力
    \global\pdftexja@curclass=\pdftexja@lastclass
    \global\pdftexja@inhibit=1
  \fi
}%

%. ------------------------------------------------------------ the hooks
% \pdftexja@pre{<cp>}: before every CJK glyph (non-math). The unified
% boundary emitter handles [candidate series] [pair glue] with the
% single penalty p = post(prev)+pre(next) at every legal candidate.

%. ------------------------------------- shared pair evaluator
% \pdftexja@classofchar{<char-or-token>} -> \pdftexja@evalclass (count):
% the JFM class of the FIRST CJK glyph of the argument, implemented by
% typesetting the argument into a scratch box with the rules hooks
% active (\pdftexja@pre records the class of every observed glyph into
% \global\pdftexja@lastclass; the box's frame push/pop keeps the
% running state intact). No CJK glyph observed -> class 27 (alchar:
% latin run semantics). Undefined codepoints read class 0 (default
% CJK, as in the JFM).
\newcount\pdftexja@evalclass
\newbox\pdftexja@evalbox
\def\pdftexja@classofchar#1{%
  \global\pdftexja@evalclass=0
  \global\pdftexja@lastclass=90
  \global\pdftexja@inhibit=0
  \setbox\pdftexja@evalbox=\hbox{#1}%
  \ifnum\pdftexja@lastclass=90
    % no CJK glyph observed: latin run (alchar semantics)
    \global\pdftexja@evalclass=27
  \else
    \global\pdftexja@evalclass=\pdftexja@lastclass
  \fi
  \global\pdftexja@lastclass=90
}
% \pdftexja@classofcp{<decimal cp>}: the JFM class of a CODEPOINT,
% read straight from the loaded class tables -- no \char (pdfTeX \char
% only addresses 0..255; \tatechuyoko's before-glue query passes the
% observed \lastnodechar scalar, a full Unicode codepoint). Contract
% mirrors \pdftexja@setclassof: undefined codepoint -> class 0, combo
% continuation -> the PREVIOUS class (callers pass a leading real glyph,
% so the combo branch is not reachable here).
\def\pdftexja@classofcp#1{%
  \expandafter\ifx\csname pdftexja@data@\pdftexja@data@prefix @combo@#1\endcsname\relax
    \expandafter\ifx\csname pdftexja@data@\pdftexja@data@prefix @dcls@#1\endcsname\relax
      \global\pdftexja@evalclass=0
    \else
      \global\pdftexja@evalclass=\csname pdftexja@data@\pdftexja@data@prefix @dcls@#1\endcsname\relax
    \fi
  \else
    \global\pdftexja@evalclass=0
  \fi}
% \pdftexjaGetPairGlue{<decimal cp A>}{<decimal cp B>}<skip> (public):
% the NATURAL width of the pair between two code points at the current
% Japanese size, i.e. the JFM pair natural (plus the kanjiskip companion
% when the pair data asks for it).  Query only: the boundary state, the
% active direction and the glyph machinery are untouched (the work runs in
% a group and restores the scratch registers it needs).
\def\pdftexjaGetPairGlue#1#2#3{%
  \begingroup
    \pdftexja@classofcp{#1}\pdftexja@evalpairglue@a=\pdftexja@evalclass
    \pdftexja@classofcp{#2}\pdftexja@evalpairglue@b=\pdftexja@evalclass
    \pdftexja@evalpairglue{\number\pdftexja@evalpairglue@a}%
                          {\number\pdftexja@evalpairglue@b}%
    % the value must leave the group: a local dimen assignment inside would
    % be discarded, and reading the target register after \endgroup reads the
    % caller's old value.
    \xdef\pdftexja@pairglue@res{\the\pdftexja@nat}%
  \endgroup
  #3=\pdftexja@pairglue@res\relax
}
\newcount\pdftexja@evalpairglue@a
\newcount\pdftexja@evalpairglue@b

% \pdftexja@evalpairglue{<class-a>}{<class-b>}: set the pair glue
% (natural only -- calc@jfmglue's contract is a skip natural) into
% \pdftexja@nat via the SAME evaluation the runtime boundary uses.
% Undefined pairs use the live fallback ((x)kanjiskip natural).
\def\pdftexja@evalpairglue#1#2{%
  % NO group: pairfields' dimen assignments are LOCAL to the current
  % level; inside a group they would be lost on close (verified: nat
  % reverted to 0). The caller (calc@jfmglue) wraps itself in \begingroup.
  \global\pdftexja@lastclass=#1\relax
  \global\pdftexja@curclass=#2\relax
  \global\pdftexja@fbmode=0
  \pdftexja@evalpair
  \ifnum\pdftexja@fbmode=1
    % fallback: the CURRENT (x)kanjiskip natural
    \pdftexja@fbskip=\pdftexja@kanjiskip
    \ifnum#1=27 \pdftexja@fbskip=\pdftexja@xkanjiskip
 \else\ifnum#2=27 \pdftexja@fbskip=\pdftexja@xkanjiskip
 \fi\fi
    \edef\pdftexja@ksnattext{\the\pdftexja@fbskip}%
    \edef\pdftexja@ksnat{\expandafter\pdftexja@ksnatsplit\pdftexja@ksnattext\relax}%
    \pdftexja@nat=\pdftexja@ksnat\relax
  \fi
}
% \pdftexjaGetSpacing{<JA-JA glue>}{<JA-Latin glue>}: evaluate the
% current providers with the caller's JA size into two skips. No state,
% provider or emitted node is changed (the target skips are the caller's).
\newskip\pdftexja@getspacing
\def\pdftexjaGetSpacing#1#2{%
  \pdftexja@getspacing=\pdftexja@kanjiskip\relax
  #1=\pdftexja@getspacing
  \pdftexja@getspacing=\pdftexja@xkanjiskip\relax
  #2=\pdftexja@getspacing
}

% Latin adjacency: when a CJK glyph is decoded at a
% paragraph/box head (lastclass=90) directly after a LATIN run
% (lastnodetype=0, a char node), the preceding latin text is treated
% as class 27 so the LA->JA boundary glue (xkanjiskip) fires.
% The check CANNOT live in \pdftexja@pre: inside the CJK decoder the
% font-switch whatsits make \lastnodetype read -1 there (verified by
% probe). It runs instead at the WRAPPED \CJK@X/XX/XXX/XXXX helper
% heads (\pdftexja@latadj), before the decoder emits anything.
% Discrimination (lastnodetype probes): latin run -> 0; indent
% box -> 1 (hlist); explicit space -> 11 (glue); kern -> 12; box ->
% 1; empty paragraph -> the indent box or nothing; ONLY type 0 is a
% char node = the latin run case. 空段落・indent・明示空白・glue・
% kern・直前boxは欧文と誤判定されない。
\def\pdftexja@latadj{%
  \ifnum\pdftexja@lastclass=90
    \ifnum\lastnodetype=0
      % direct latin adjacency at a paragraph/box head: class 27
      \global\pdftexja@lastclass=27
    \else
      % With every glyph boxed (boxglyphs), the preceding node is
      % OUR glyph box, not a char -- the glyphmark distinguishes it
      % from a user box (boxbdd keeps user boxes neutral).
      \ifnum\lastnodetype=1
        \ifnum\pdftexja@glyphmark=1
          \global\pdftexja@lastclass=27
        \fi
      \fi
    \fi
  \fi
}
\def\pdftexja@pre#1{%
  \ifmmode
    % CJK char inside math: no glue, no penalty, state untouched
    % (math counts as an alchar/latin boundary, set by the $-peek or
    % left over from the preceding latin run)
  \else
    % If the reader directly follows a closed user box, apply
    % boxbdd semantics -- the boundary pseudo class 90, not the stale
    % interior state (see \pdftexja@boxbdd).
    \pdftexja@boxbdd
    \pdftexja@setclassof{#1}%
    % Ruby adapter: while a ruby base pass is armed, record the
    % FIRST observed glyph's class/zw for the ruby's left boundary
    % (no-op unless \pdftexja@ruby@rec is armed; defined in
    % pdftexja-ruby.sty -- never re-run the base for this)
    \pdftexja@ruby@recordfirst
    \ifnum\pdftexja@inhibit=1
      \global\pdftexja@inhibit=0
    \else
      \pdftexja@beforeglyph
      \pdftexja@setpost
    \fi
    \global\pdftexja@lastclass=\pdftexja@curclass
    % This glyph's node (bare char or our nest-guarded charbox)
    % is about to become the last node; mark it ours so a following
    % \lastnodetype=13/14 read at the next boundary is not mistaken
    % for a user box (see the semantic-frames comment).
    \global\pdftexja@glyphmark=1
  \fi
}
% \pdftexja@beforeglyph: the zero-glue \unskip (kinsoku residual --
% removes a FOREIGN zero-natural glue before a prebreak char; real,
% stretchy or negative user glue is never touched) then the boundary.
\def\pdftexja@beforeglyph{%
  \pdftexja@getkin{pre}{\number\pdftexja@curclass}%
  \ifnum\pdftexja@kinval=\z@
  \else
    \ifnum\lastnodetype=11
      \ifdim\lastskip=0pt
        \unskip
      \fi
    \fi
  \fi
  \pdftexja@emitpair
}
% \pdftexja@peek: installed as \CJK@ignorespaces; runs after every CJK
% glyph. Detects a latin (or math-shift) follower and emits the
% CJK->LA boundary through the SAME unified emitter.
% この形は避ける: 「\ifmmode\else\futurelet..\fi」形は CJKutf8 の \CJK@XXX 末尾条件
% （\expandafter\CJK@ignorespaces\else..\fi\fi の残り \fi 群内）で展開され
% ると壊れる: \else スキップで消えたはずの \pdftexja@peek@a が古い
% \pdftexja@peek@next で実行され，\CJK@XXX 末尾の \fi 群と突いて Extra \fi
% （再現条件: 直前に和文がある状態の $あ$ / 行列セル内和文）．
% R15 INVARIANT: the lookahead cs must be PRIVATE to the peek machinery
% (\pdftexja@peek@next, never a name another module also assigns).  When a
% branch ends in a CJK glyph, \futurelet<cs>\pdftexja@peek@a takes the
% caller's \fi as <token2>, so <cs> becomes an alias of the \fi primitive
% and stays so.  TeX's conditional skipper (pass_over) recognises ANY token
% whose meaning is a conditional: if shared code later mentions <cs> inside
% a branch that TeX is skipping -- e.g. the `\let\...@next\@firstoftwo' in
% \pdftexjaIfDirectionTF's own skipped true branch -- the skipper reads it
% as \fi, closes a nesting level early, skips BOTH branches and leaves the
% caller's \fi unmatched ("Extra \fi"; minimal: two \today calls in one
% document).  A private name makes the stale alias unreadable elsewhere,
% and unlike a lookahead fence it leaves the token stream and node stream
% byte-identical for every follower, so ruby's aftergroup ordering and the
% pdfjsbook/pdfjspf line counts are untouched.
% 未来let本体を\elseスキップ域の外へ出し，数式時は引数ごと捨てる
% \@gobble イディオムに変える（引数形なのでスキップ域に未来letが残らない）．
\def\pdftexja@peek{%
  \ifmmode
    \expandafter\@gobble
  \else
    \expandafter\@firstofone
  \fi
  {\pdftexja@peek@do}%
}
% \pdftexja@peek@resume -- the aftergroup continuation of a peek
% deferred at a group end. It is the plain futurelet form: no
% correction is re-emitted at the group end itself (the follower's
% own hook emits the boundary), so no double boundary emission can
% happen. Note: when the closing group was a BOX whose
% last node was a CJK glyph, this resume still runs its \futurelet at
% the box edge -- the case \leaders\hbox{..<CJK>}<glue> remains
% unsupported (leader boxes with a bare CJK tail; the LaTeX TOC
% leader box ends in \null after the glyph, so the TOC path never
% defers). The universal leader breakage (every \leaders box, any
% content, via the frame-pop \aftergroup) is fixed by removing that
% \aftergroup (see the semantic-frames comment above).
\def\pdftexja@peek@resume{\pdftexja@peek}
% 非数式モードのときだけ実行される本体．
\def\pdftexja@peek@do{%
  \futurelet\pdftexja@peek@next\pdftexja@peek@a
}
% CJK -> latin/math boundary: emit through the unified machinery with
% curclass=27 (the inhibit interlock is consumed here too --
% \inhibitglue between a CJK glyph and a latin run suppresses the
% xkanjiskip exactly once).
\def\pdftexja@peek@lat{%
  {\global\pdftexja@curclass=27
   \pdftexja@emitpair}%
  \global\pdftexja@lastclass=27
}

\def\pdftexja@peek@a{%
  \ifx\pdftexja@peek@next\inhibitglue
    % \inhibitglue directly after a CJK glyph: consume it, execute it
    % (sets the interlock) and re-peek at the REAL follower, so a
    % latin follower goes through peek@lat -- which consumes the
    % interlock and suppresses the boundary glue exactly once (ltj
    % semantics; the 漢\inhibitglue abcあ case: the abc->あ boundary
    % then behaves normally instead of eating a second suppression).
    % The dispatch goes through a one-token body macro so the argument
    % scan of \pdftexja@eatig reaches the INPUT (the original token),
    % not this macro's own body (\else etc.).
    % No \expandafter here: the next token in the stream is the CALLER's
    % follower (possibly its \fi), and \expandafter would expand it and close
    % the caller's conditional early ("Extra \else" when a CJK glyph is the
    % last token of a branch, e.g. two \today calls in one document).
    \pdftexja@peek@ig
  \else
    \pdftexja@peek@rest
  \fi
}
\def\pdftexja@peek@ig{\pdftexja@eatig}
% (R15 closed: the lookahead fence -- \futurelet<cs>\A\B with \B an empty
% macro -- also stopped the caller's \fi from being re-pushed, but it put an
% extra token into the stream: one line shifted in pdfjsbook/pdfjspf page 1
% and both ruby gates failed.  The shared-cs alias described in the R15
% INVARIANT above was the actual defect; the fence was removed and is not
% coming back -- do not reintroduce it.)
% eat the lookahead'd \inhibitglue token, execute it, re-peek at the
% real follower (taking it as an argument CONSUMES the token: a plain
% token insertion looped forever on the never-consumed original)
\def\pdftexja@eatig#1{#1\pdftexja@peek}
\def\pdftexja@peek@rest{%
  \ifx\pdftexja@peek@next\@sptoken
    % explicit space: neutral (ltj's glue pseudo-char: no boundary
    % glue across a user space)
    \global\pdftexja@lastclass=93
  \else
    \ifx\pdftexja@peek@next\egroup
      % group end: resume the peek after the group.
      % The resume macro (not \pdftexja@peek itself) first checks
      % whether the group that closed was a BOX (\lastnodetype 13/14
      % and glyphmark=0): a box edge is boxbdd, no boundary glue is
      % emitted against the box, and -- critically -- the check makes
      % the aftergroup token expand to NOTHING there, so
      % \leaders\hbox{...}<glue> scans stay intact (this aftergroup
      % is what previously surfaced as \futurelet inside the leader
      % glue scan). Plain {..} groups contribute no node, so the
      % resumed peek proceeds there exactly as before.
      \aftergroup\pdftexja@peek@resume
    \else
      \ifx\pdftexja@peek@next$%
        \pdftexja@peek@lat
      \else
        % tate では $ はアクティブ文字になる（pdftexja.sty の数式
        % キャプチャ入口）．アクティブ$トークンの意味は
        % \pdftexja@tate@dollar@cmp と一致するため，その \ifx で捕える．
        % 横組みでは \pdftexja@tate@dollar@cmp は未定義のままで，
        % この枝は常に偽（既存挙動と一致）．
        \ifx\pdftexja@peek@next\pdftexja@tate@dollar@cmp
          \pdftexja@peek@lat
        \else
        \ifcat\noexpand\pdftexja@peek@next a%
          \pdftexja@peek@lat
        \else
          \ifcat\noexpand\pdftexja@peek@next 1%
            \pdftexja@peek@lat
          \else
            % CJK bytes, control sequences, groups: leave the state;
            % the follower's own hook handles the pair
          \fi
        \fi
        \fi
      \fi
    \fi
  \fi
}
\def\pdftexja@eatig#1{#1\pdftexja@peek}
% (peek@cont removed -- its role was "futurelet-only
% continuation" to avoid the double hangkern, but hangkern itself is
% gone with the old rpcode machinery; the aftergroup peek at egroup is
% already the plain futurelet form. No caller remains.)

% \pdftexja@glyph{<cp>}: the glyph typesetter called from the inner
% \CJKsymbol hook (all UTF-8 routes funnel here under noCJKpunct).
% JFM class metrics say the glyph advance may be < 1zw (class@<n>
% {w}{h}{d}{align}: e.g. 約物 class 1/2/6/7 = 0.5zw, 半角 class 192
% = 0.333zw). The font glyph is always full-width (IPAex), so the
% JFM width is realized by typesetting the glyph in an \hbox of the
% JFM width and positioning it per the class align field
% (ltj/luatexja-jfm.lua: the "align" table shifts the glyph inside
% the char box):
%   left   = glyph at the LEFT edge of the box (overhangs right)
%   middle = glyph centered (overhangs both)
%   right  = glyph at the RIGHT edge of the box (overhangs left)
% w = 1zw (or no metrics: default CJK class) -> unchanged typesetting
% (no box, byte-identical node stream, marker-kern machinery safe).
% The JFM h/d stay font-natural: align placement is horizontal only
% (the box keeps the glyph's own height/depth, as in ltj where the
% vertical metrics are untouched). The IPAex glyph is always
% FULL-width (1zw) while the box is w<1zw, so the box is SHORTER than
% its content: the spacers must be \hss (negative shrink). \hfil
% (plus-only) cannot shrink and turns every narrowed punct into an
% overfull box.
\def\pdftexja@glyph#1{%
  \ifmmode
    \ifnum\pdftexja@opt@mathcapture=\z@
      \PackageError{pdftexja}{%
        Japanese text in math is not allowed (math-capture=false)}{%
        The~package~option~math-capture=false~disables~the~automatic\MessageBreak
        Japanese~formula~capture,~so~a~bare~Japanese~character~inside~math\MessageBreak
        has~no~defined~layout.~Wrap~it~in~a~registered~math~text~command\MessageBreak
        (e.g.~\string\mathmc{...}~or~\string\text{...}).\MessageBreak
        \@ehc}%
    \fi
    % 数式内: \hboxに包んで出す．数式中の\charはバイト値を「ASCIIのmathcode」
    % で再解釈してしまう（あ=U+3042→サブフォントバイト0x42が欧文フォントの
    % 「B」と化ける）ため、\charがテキストモード扱いに戻る\hboxが必須．
    % C70フォント選択は\CJK@punctchar側の\usefont群が済ませているので
    % フォントはボックス内に引き継がれる．
    % \pdftexja@preは数式でクラス更新しないためJFM狭めボックス等も使わず，
    % 常に自然幅．状態には触れない．
    % backend-internal box: guard the frame machinery
    \global\advance\pdftexja@nest1
    \hbox{\pdftexja@orig@CJKsymbol{#1}}%
    \global\advance\pdftexja@nest-1
  \else
    \ifnum\pdftexja@dir=1
      \pdftexja@glyph@tate{#1}%
    \else
      \expandafter\ifx\csname pdftexja@data@\pdftexja@data@prefix @class@\number\pdftexja@curclass\endcsname\relax
        \pdftexja@orig@CJKsymbol{#1}%
      \else
        \expandafter\pdftexja@placeglyph
          \csname pdftexja@data@\pdftexja@data@prefix @class@\number\pdftexja@curclass\endcsname
          {#1}%
      \fi
    \fi
  \fi
}
%. --------------------------------------------------------- tate glyph
% 縦組みグリフ（プロファイル駆動）. 1 グリフ = 内側（水平段落）枠
% 組みの JFM クラス幅進行ボックス。グリフ選択はフォントプロファイル
% （pdftexja-fonts-*.def が供給、pdftexja.sty が読み込む）:
%   \pdftexja@vglyph@<HEX>{{sub}{adv}{vorg}{ink x0 y0 x1 y1}{shard}{slot}{uni}}
% sub=1 → 補助縦フォントの真縦字形（upright・回転なし）を slot 経由で
%   出力（advance は vmtx 由来）。
% sub=0 → 通常グリフを 90°（CCW）回転（内枠組；出荷の -90° で正立）。
% 進行幅 = JFM クラス幅（class@<n> の w）× 現在 \pdftexja@zw。固定 1zw は
% 使わない。高さ/深さ = JFM クラスの h/d × \pdftexja@zw（縦組みデータは
% 0.5/0.5）。ink/vorigin 補正は em 単位 × 現在の jareg で毎回計算
% （サイズ/書体/系列変更後もプロファイル×現zwで再計算される）。
% 旧 off@<class> 生 pt 表（10pt 代表字由来）は廃止。
\def\pdftexja@glyph@tate#1{%
  % \pdftexja@pre (called first by the CJKsymbol wrap) restores the
  % Unicode codepoint into \pdftexja@cp (the raw #1 here is just the
  % plane byte: `\CJK@plane*256+#1').  The profile keys are DECIMAL
  % codepoints.
  \expandafter\ifx\csname pdftexja@vglyph@\number\pdftexja@cp\endcsname\relax
    \pdftexja@glyph@tate@plain{#1}%
  \else
    \expandafter\pdftexja@vgparse
      \csname pdftexja@vglyph@\number\pdftexja@cp\endcsname
    \ifnum\pdftexja@vg@sub=1
      \pdftexja@glyph@tate@vert{#1}%
    \else
      \pdftexja@glyph@tate@rot{#1}%
    \fi
  \fi
}
% {{sub}{adv}{vorg}{{x0}{y0}{x1}{y1}}{shard}{slot}{uni}}
\def\pdftexja@vgparse#1{\expandafter\pdftexja@vgparse@a#1}
\def\pdftexja@vgparse@a#1#2#3#4#5#6#7{%
  \pdftexja@vg@sub=#1
  \def\pdftexja@vg@adv{#2}%
  \def\pdftexja@vg@vorg{#3}%
  \def\pdftexja@vg@ink{#4}%
  \def\pdftexja@vg@shard{#5}%
  \def\pdftexja@vg@slot{#6}%
  \def\pdftexja@vg@uni{#7}%
}
\newcount\pdftexja@vg@sub
% sub=0: rotate the normal glyph; place ink per the profile ink/vorg in em
% units against the JFM class cell.  The old fixed raise/shift pt table is
% replaced by per-glyph em data × current \pdftexja@jareg.
% 挿入物文脈フラグ \pdftexja@insctx (=1 のとき): 挿入物(脚注等)の
% 内側では縦字形ボックスの ht/dp を JFM クラスの h/d×zw に正規化する。
% 本文では従来どおり rotatebox の自然寸法(ht=エム/dp=0)のまま — 本文側は
% 出荷回転の第一行カーンでこの規約を補正しているため(実測一致)。
% 挿入物側は native 縦組と同じ「エム箱が行基準線を挟んで中央」の
% 行内配置が全行(折返し行・複数段落脚注を含む)で得られる。
\newcount\pdftexja@insctx \global\pdftexja@insctx=0
\def\pdftexja@glyph@tate@rot#1{%
  \pdftexja@tate@classdims
  % backend-internal box: guard the frame machinery
  \global\advance\pdftexja@nest1
  \setbox\pdftexja@charbox=\hbox{%
    \rotatebox{90}{\pdftexja@orig@CJKsymbol{#1}}}%
  \global\advance\pdftexja@nest-1
  \wd\pdftexja@charbox=\pdftexja@cls@w\pdftexja@zw
  \ifnum\pdftexja@insctx=1
    \ht\pdftexja@charbox=\pdftexja@cls@h\pdftexja@zw
    \dp\pdftexja@charbox=\pdftexja@cls@d\pdftexja@zw
  \fi
  \box\pdftexja@charbox}
% sub=1: true vertical form from the auxiliary vertical font. The aux
% TFM is selected per family and the slot glyph is typeset inside the
% JFM-width cell.
% 脚注ブロック実測修正: 内枠（水平組み）は出荷の -90° 回転の
% 「回転前」空間であるため、その中身はすべて +90° 予備回転して
% 組む必要がある（rot path は \rotatebox{90} で行っている）。
% vert path は補助縦フォントの字形を素のまま描いていたため、
% 最終ページで全補助縦字形（（）。ー 等 sub=1 の全文字）が
% 90° 横倒しで刷られていた（実測: fn （ が横倒し、native と
% 形状不一致）。rot path と同じ回転を補助字形にもかけ、
% 回転後のボックス寸法は JFM クラスの w/h/d×zw で正規化する。
% さらに native vf と同一の置き型として、半角クラスの全角進行
% 字形を -(1zw-セル幅) だけ行頭側へずらして描く（uplatex 実測:
% （ セル [c,c+0.5em] に対し ink [c,c+1em]）。
\def\pdftexja@glyph@tate@vert#1{%
  \pdftexja@tate@classdims
  \global\advance\pdftexja@nest1
  \setbox\pdftexja@charbox=\hbox{%
    \kern\dimexpr\pdftexja@cls@w\pdftexja@zw-1\pdftexja@zw\relax
    \rotatebox{90}{%
      \pdftexja@auxfont
      \expandafter\char\pdftexja@vg@slot\relax}}%
  \global\advance\pdftexja@nest-1
  \ht\pdftexja@charbox=\pdftexja@cls@h\pdftexja@zw
  \dp\pdftexja@charbox=\pdftexja@cls@d\pdftexja@zw
  \wd\pdftexja@charbox=\pdftexja@cls@w\pdftexja@zw
  \box\pdftexja@charbox}
% no profile entry (e.g. yoko-only font in tate): rotate the plain glyph
% and keep the class width -- but ONLY when a profile exists at all;
% missing profile is a load-time error, not a silent fallback.
\def\pdftexja@glyph@tate@plain#1{%
  \pdftexja@glyph@tate@rot{#1}}
% class dims: w from class@<n>; h/d applied via the box's height/depth
\def\pdftexja@tate@classdims{%
  \expandafter\ifx\csname pdftexja@data@\pdftexja@data@prefix @class@\number\pdftexja@curclass\endcsname\relax
    \def\pdftexja@cls@w{1}%
  \else
    % NOTE the #1 wrapper: `\expandafter\splitcls\csname...' hands the
    % CLASS MACRO TOKEN to splitcls as ONE undelimited argument (the
    % same rule as \pdftexja@easeries) -- the wrapper expands the
    % macro first so splitcls sees the five brace-group fields.
    \expandafter\pdftexja@tate@classdims@split
      \csname pdftexja@data@\pdftexja@data@prefix @class@\number\pdftexja@curclass\endcsname
  \fi
}
\def\pdftexja@tate@classdims@split#1{\expandafter\pdftexja@splitcls#1}
% #1 = {{w}{h}{d}{align}{left}}, #2 = codepoint
% The JFM-width glyph box is THE standard for punct classes
% (no bare-glyph hanging branch; hanging protrusion is the negative
% end_adjust candidate of the SAME box glyph, applied at line end by
% the candidate series).
\def\pdftexja@placeglyph#1#2{%
  \expandafter\pdftexja@splitcls#1%
  \edef\pdftexja@tmpw{\pdftexja@cls@w\pdftexja@zw}%
  \ifdim\pdftexja@tmpw=1\pdftexja@zw
    \ifnum\pdftexja@boxglyphs=1
      % The strict paragraph environment boxes EVERY glyph
      % (1zw classes too) so its line interior contains only
      % boxes/glues/kerns/penalties -- the per-line distribution walk
      % can then address each item box. Nest-guarded like the punct
      % path (same frame-machinery reason).
      \global\advance\pdftexja@nest1
      \setbox\pdftexja@charbox=\hbox{\pdftexja@orig@CJKsymbol{#2}}%
      \hbox to \pdftexja@cls@w\pdftexja@zw{%
        \pdftexja@placealign
        \box\pdftexja@charbox
        \pdftexja@placealign@post}%
      \global\advance\pdftexja@nest-1
    \else
      \pdftexja@orig@CJKsymbol{#2}%
    \fi
  \else
    % backend-internal boxes: guard the frame machinery for BOTH the
    % measurement hbox and the outer JFM-width hbox (the everyhbox
    % hook must not push a frame here -- the glyph box is not a
    % semantic boundary and its push would neutralize lastclass
    % mid-run, wrecking the NEXT boundary's pair lookup).
    \global\advance\pdftexja@nest1
    \setbox\pdftexja@charbox=\hbox{\pdftexja@orig@CJKsymbol{#2}}%
    \hbox to \pdftexja@cls@w\pdftexja@zw{%
      \pdftexja@placealign
      \box\pdftexja@charbox
      \pdftexja@placealign@post}%
    \global\advance\pdftexja@nest-1
  \fi
}
% {<w>}{<h>}{<d>}{<align>}{<left>} -- brace-group delimited (the .def
% values are exactly one brace group each; digit-bearing control words
% are formed via \csname at the caller, never by \def here)
% h/d も保存する（縦字形ボックスの ht/dp を JFM クラス値で
% 正規化するため。cls@h/cls@d は {0.5} のような係数）。
\def\pdftexja@splitcls#1#2#3#4#5{%
  \def\pdftexja@cls@w{#1}%
  \def\pdftexja@cls@h{#2}%
  \def\pdftexja@cls@d{#3}%
  \def\pdftexja@cls@align{#4}%
}
\def\pdftexja@cls@h{0.5}%
\def\pdftexja@cls@d{0.5}%
% leading spacer: absent for left (glyph flush left), \hss otherwise
\def\pdftexja@placealign{%
  \def\pdftexja@tmpb{left}%
  \ifx\pdftexja@cls@align\pdftexja@tmpb
    \expandafter\@gobble
  \else
    \expandafter\@firstofone
  \fi
  {\hss}%
}
% trailing spacer: absent for right (glyph flush right), \hss otherwise
\def\pdftexja@placealign@post{%
  \def\pdftexja@tmpb{right}%
  \ifx\pdftexja@cls@align\pdftexja@tmpb
    \expandafter\@gobble
  \else
    \expandafter\@firstofone
  \fi
  {\hss}%
}

%. --------------------------------------------------- public state APIs
% \pdftexjaGetMetrics{yoko|tate}<wd dimen><ht dimen><dp dimen>: normal
% role class dimensions of the NAMED direction's payload, scaled by the
% current Japanese size. No direction switch, no glyph emission, no
% boundary state change; fully group-protected (\global target writes
% only). Undefined class data yields zero dimensions.
\def\pdftexjaGetMetrics#1#2#3#4{%
  \begingroup
    \@ifundefined{pdftexja@data@prefix@#1}{%
      \PackageError{pdftexja}{JFM direction `#1' is not loaded}{%
        Use~yoko~or~tate.\MessageBreak \@ehc}%
      \global#2=\z@ \global#3=\z@ \global#4=\z@
    }{%
      \expandafter\edef\expandafter\pdftexja@metrics@prefix
        \expandafter{\csname pdftexja@data@prefix@#1\endcsname}%
      \expandafter\ifx\csname pdftexja@jfm@role@normal\endcsname\relax
        \global#2=\z@ \global#3=\z@ \global#4=\z@
      \else
        \edef\pdftexja@metrics@cls{\csname pdftexja@jfm@role@normal\endcsname}%
        \expandafter\ifx
          \csname pdftexja@data@\pdftexja@metrics@prefix @class@\pdftexja@metrics@cls\endcsname
          \relax
          \global#2=\z@ \global#3=\z@ \global#4=\z@
        \else
          \expandafter\pdftexja@metrics@split
            \csname pdftexja@data@\pdftexja@metrics@prefix @class@\pdftexja@metrics@cls\endcsname
          \global#2=\pdftexja@cls@w\pdftexja@jareg
          \global#3=\pdftexja@cls@h\pdftexja@jareg
          \global#4=\pdftexja@cls@d\pdftexja@jareg
        \fi
      \fi
    }%
  \endgroup}
\def\pdftexja@metrics@split#1{\expandafter\pdftexja@splitcls#1}
% \pdftexjaBoundaryBegin / \pdftexjaBoundaryEnd: save/restore the
% out-of-flow boundary tuple {lastclass}{lastnodechar}{pend}{inhibit}
% {dir}{lastzw}{glyphmark}{lastkern}. \lastkern is TeX-owned and can only
% be recorded, not restored (callers re-emit their own net-zero marker).
% Unmatched End is an error.
\newcount\pdftexja@boundary@ptr
\def\pdftexjaBoundaryBegin{%
  \global\advance\pdftexja@boundary@ptr\@ne
  \expandafter\xdef\csname pdftexja@boundary@\the\pdftexja@boundary@ptr\endcsname{%
    {\number\pdftexja@lastclass}%
    {\number\pdftexja@lastnodechar}%
    {\number\pdftexja@pend}%
    {\number\pdftexja@inhibit}%
    {\number\pdftexja@dir}%
    {\the\pdftexja@lastzw}%
    {\number\pdftexja@glyphmark}%
    {\the\lastkern}}%
}
\def\pdftexjaBoundaryEnd{%
  \ifnum\pdftexja@boundary@ptr=\z@
    \PackageError{pdftexja}{\string\pdftexjaBoundaryEnd\space without a matching begin}{%
      The~boundary~stack~is~empty.\MessageBreak \@ehc}%
  \else
    \expandafter\pdftexja@boundary@restore
      \csname pdftexja@boundary@\the\pdftexja@boundary@ptr\endcsname
    \global\advance\pdftexja@boundary@ptr\m@ne
  \fi}
\def\pdftexja@boundary@restore#1{%
  \expandafter\pdftexja@boundary@restore@a#1}
\def\pdftexja@boundary@restore@a#1#2#3#4#5#6#7#8{%
  \global\pdftexja@lastclass=#1\relax
  \global\pdftexja@lastnodechar=#2\relax
  \global\pdftexja@pend=#3\relax
  \global\pdftexja@inhibit=#4\relax
  \global\pdftexja@lastzw=#6\relax
  \global\pdftexja@glyphmark=#7\relax
  \pdftexja@setdir{#5}%
}
% \pdftexjaInsertionMetrics{body}: typeset body once with the insertion
% logical-glyph metric mode on, restoring the previous mode afterwards.
\long\def\pdftexjaInsertionMetrics#1{%
  \begingroup
    \global\advance\pdftexja@insctx\@ne
    #1%
    \global\advance\pdftexja@insctx\m@ne
  \endgroup}

%. -------------------------------------------------------- installation
% Everything touching CJK/bxcjkjatype definitions must run AFTER those
% packages load (the parent loads this file first, bxcjkjatype after;
% bxcjkjatype itself redefines the inner \CJKsymbol, which would
% overwrite a load-time wrap). All of it is deferred to begin-document.
\newtoks\pdftexja@evhbox
\newtoks\pdftexja@evvbox
\def\pdftexja@evh@tmp{}%
% \pdftexja@evh@save<everyhbox|everyvbox>: capture the current tokens
% (via \edef -- a `\toks=\expandafter{...}' scan is invalid syntax)
% into the paired scratch register, then re-assign the primitive with
% our hook PREPENDED (user tokens still run exactly once, after ours).
\def\pdftexja@evh@save#1#2{%
  \edef\pdftexja@evh@tmp{\the#1}%
  \global#2\expandafter{\pdftexja@evh@tmp}%
}
\AtBeginDocument{%
  % (a) neutralize CJK's own inter-char glue: our pair glue resets
  %     \lastkern so their \CJK@testLastCJK/\CJK@testLastKern machinery
  %     cannot fire after our nodes; nulling the two glue macros makes
  %     the cases where we emit NOTHING (math, explicit space,
  %     inhibited boundaries) safe from double spacing too. Their
  %     net-zero marker kerns (\CJK@kern/\CJK@CJK) stay untouched.
  \renewcommand{\CJKglue}{}%
  \def\CJK@nobreakglue{\nobreak}%
  % (b) wrap the inner \CJKsymbol (robust-command internals; every
  %     UTF-8 route funnels here under noCJKpunct): class lookup,
  %     pair glue and kinsoku before the glyph
  \expandafter\let\expandafter\pdftexja@orig@CJKsymbol
    \csname CJKsymbol \endcsname
  \expandafter\def\csname CJKsymbol \endcsname#1{%
    \pdftexja@pre{#1}\pdftexja@glyph{#1}%
  }%
  % (c) post-glyph peek: the byte macros append \CJK@ignorespaces after
  %     each char (\CJKspace sets it to \@empty).
  %     F-peek fix: \CJK@ignorespaces runs INSIDE the helper's \ifx..\else
  %     branch (CJK@X/XX/XXX/XXXX, CJK.sty:975-1012), so a \futurelet there
  %     sees the helper's own trailing \fi, never the real follower --
  %     peek@lat (CJK->LA xkanjiskip) could never fire. Instead, restore
  %     \CJK@ignorespaces to its passive job (\@empty via \CJKspace) and
  %     wrap the four helpers so our peek runs AFTER the helper returns,
  %     i.e. after its \ifx has closed: \futurelet then sees the real
  %     next token.
  \global\let\CJK@ignorespaces\@empty
  \expandafter\let\csname pdftexja@orig@CJK@X\expandafter\endcsname
    \csname CJK@X\endcsname
  \expandafter\def\csname CJK@X\endcsname#1{%
    \pdftexja@latadj\csname pdftexja@orig@CJK@X\endcsname{#1}%
    \futurelet\pdftexja@peek@next\pdftexja@peek@a}%
  \expandafter\let\csname pdftexja@orig@CJK@XX\expandafter\endcsname
    \csname CJK@XX\endcsname
  \expandafter\def\csname CJK@XX\endcsname#1#2{%
    \pdftexja@latadj\csname pdftexja@orig@CJK@XX\endcsname{#1}{#2}%
    \futurelet\pdftexja@peek@next\pdftexja@peek@a}%
  \expandafter\let\csname pdftexja@orig@CJK@XXX\expandafter\endcsname
    \csname CJK@XXX\endcsname
  \expandafter\def\csname CJK@XXX\endcsname#1#2#3{%
    \pdftexja@latadj\csname pdftexja@orig@CJK@XXX\endcsname{#1}{#2}{#3}%
    \futurelet\pdftexja@peek@next\pdftexja@peek@a}%
  \expandafter\let\csname pdftexja@orig@CJK@XXXX\expandafter\endcsname
    \csname CJK@XXXX\endcsname
  \expandafter\def\csname CJK@XXXX\endcsname#1#2#3#4{%
    \pdftexja@latadj\csname pdftexja@orig@CJK@XXXX\endcsname{#1}{#2}{#3}{#4}%
    \futurelet\pdftexja@peek@next\pdftexja@peek@a}%
  % (d) semantic frames: PREPEND our state hook to the primitive
  %     everyhbox/everyvbox tokens (kernel's everymath-style freeze:
  %     capture the pre-existing user tokens into scratch token
  %     registers FIRST, then re-assign; the captured copy runs exactly
  %     once, after ours. Every box opens a group -> \aftergroup
  %     restores the parent state at close. Backend-internal boxes are
  %     guarded via \pdftexja@nest (see glyph/placeglyph/math).
  \pdftexja@evh@save\everyhbox\pdftexja@evhbox
  \global\everyhbox{\pdftexja@box@enter\the\pdftexja@evhbox}%
  \pdftexja@evh@save\everyvbox\pdftexja@evvbox
  \global\everyvbox{\pdftexja@box@enter\the\pdftexja@evvbox}%
  % (e) para/end hook: the short-final-line tail kern. \AddToHook{para/end}
  %     runs when the paragraph is being wrapped up -- BEFORE
  %     \parfillskip is contributed by TeX's paragraph builder? No:
  %     para/end runs when \par finishes the paragraph; material
  %     contributed there lands at the end of the paragraph content
  %     (before \parfillskip/\rightskip which TeX appends during
  %     line breaking). The tail kern is thus the last node before
  %     parfillskip -- the ltj insert_lineend_kern_tail position.
  \AddToHook{para/end}{\pdftexja@para@endhook}%
  % (f) document-start state: paragraph-boundary class, neutral scalars
  \pdftexja@state@neutral
}


\makeatother

\endinput
